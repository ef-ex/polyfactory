// STAGE 2 - PLAN (spec 4.2), THE FITTING SOLVE.  POINT wrangle, precision 64.
//   input 0  the SECTION stream (one point per section, from pc_sections)
//   input 1  CONFIG (pc_cfg + the kit table + the rule table)
//
// `plan.plan_section` ported.  ONE SECTION PER THREAD, and the sequential
// accumulation stays sequential INSIDE that thread - which is the data
// dependency the solve actually has.  It ADDS NO POINTS: the answer leaves as
// PER-SECTION ARRAYS plus `_npieces`, and `pc_plan_expand` (a
// `pointgenerate`) turns that into one point per piece.
//
// ⚠️ THAT SHAPE IS D150 AND IT IS NOT A STYLE CHOICE.  `addpoint` from a
// multithreaded wrangle emits points in THREAD-COMPLETION order, so
// `determinism` and `geometry_digest` - pinned on all 89 cases - would become
// a lottery.  `pointgenerate` expands deterministically and index k is then a
// pure function of (section, k) with no ordering in it at all.
//
// ⚠️ AND IT IS A POINT WRANGLE, NOT A DETAIL ONE.  A detail wrangle would run
// every section of the build through one thread, which is the shape that made
// the Python slow in the first place.
//
// 4.3's corner reserve arrives as `pc_trim_a` / `pc_trim_b`, which are 0
// until 13.9 N8 lands - and 0 is exactly `plan_sections`' own `trim=(0, 0)`.

#include "pc_plan.h"

// ---- the section -----------------------------------------------------------
string CURVE_ID = s@pc_curve_id;
int    SEC_IX   = i@pc_sec_index;
float  SEC_S0   = f@pc_sec_s0;
float  SEC_S1   = f@pc_sec_s1;
float  CURVE_L  = f@pc_curve_len;
int    CLOSED   = i@pc_sec_closed;
int    SCAP     = i@pc_start_cap;
int    ECAP     = i@pc_end_cap;
float  ANGLE    = f@pc_corner_angle;
string YCLASS   = s@pc_yclass;
float  TRIM_A   = f@pc_trim_a;
float  TRIM_B   = f@pc_trim_b;

float L = SEC_S1 - SEC_S0;

// the output plan, as parallel arrays
string o_slot[], o_module[], o_variant[], o_zmode[], o_warns[];
int o_index[], o_deform[];
float o_s0[], o_s1[], o_u[], o_scale[], o_slice[];

i@_npieces = 0;
if (L <= PC_PEPS) {
    s[]@_p_slot = o_slot; s[]@_p_module = o_module;
    s[]@_p_variant = o_variant; s[]@_p_zmode = o_zmode;
    s[]@_p_warns = o_warns; i[]@_p_index = o_index;
    i[]@_p_row = o_index;               // empty, and the attribute must exist
    i[]@_p_deform = o_deform; f[]@_p_s0 = o_s0; f[]@_p_s1 = o_s1;
    f[]@_p_u = o_u; f[]@_p_scale = o_scale; f[]@_p_slice = o_slice;
    return;                                     // D8: a curve, but no span
}

// ---- ctx_base: 3.3's subject bag, split by type ---------------------------
// `cond_subject` reads one bag; VEX dict slots are typed, so it is two here
// and `pc_cond_subject` tries the numeric one first.  The `attr:` and
// `markerData:` prefixes are part of the KEY, exactly as 3.3 writes them.
//
// ⚠️ THIS BAG MUST BE `plan_section`'s `ctx_base`, KEY FOR KEY, AND IT WAS
// NOT.  `cond_subject` ends in `ctx.get(subject)`, so EVERY key of `ctx_base`
// is a readable subject - not only the five names `plan.COND_SUBJECTS`
// documents.  Two mirror-image defects were measured on the shipped build:
//   * `segIndex` was defined HERE, at every pick made outside the fill loop,
//     where the reference has no such key.  One rule
//     `{subject: segIndex, op: lt, value: 1}` on a 20 m line built 10 panels
//     natively and 0 pieces in the reference.
//   * `curve_id`, `section_index` and `yclass` are in `ctx_base` and were
//     absent here, and `slot` (which `pick` adds, and `pc_choose` adds now)
//     was absent too - each one measured as a 10-vs-11-piece divergence.
// The seg index belongs to `_fill` and to nothing else; the other four
// belong here.  `stress_cases` carries a row for each of the five.
float U0 = (CURVE_L <= PC_PEPS) ? 0.0 : SEC_S0 / CURVE_L;
dict CF, CS;
CF["sectionLength"] = L;
CF["splineLength"]  = CURVE_L;
CF["cornerAngle"]   = ANGLE;
CF["u"]             = U0;
CF["section_index"] = (float)SEC_IX;
CS["curve_id"]      = CURVE_ID;
CS["yclass"]        = YCLASS;
dict af = d@_attr_f, as_ = d@_attr_s;
foreach (string k; keys(af)) { float v = af[k]; CF[sprintf("attr:%s", k)] = v; }
foreach (string k; keys(as_)) { string v = as_[k]; CS[sprintf("attr:%s", k)] = v; }
// D202 - and the subjects that are PRESENT BUT UNREADABLE, under the sentinel
// prefix `pc_cond_subject` looks for.  Two sources: an `attr:` name whose prim
// attribute is a vector or an array (`pc_sections` names them in `_attr_bad`),
// and `ctx_base`'s own two DICT-valued keys, which `cond_subject` ends in
// `ctx.get(subject)` and therefore reaches - `{} != "zzz"` is True in Python
// and was False here, measured as a 10-vs-12-piece plan divergence.
string abad[] = s[]@_attr_bad;
foreach (string k; abad) CS[concat(PC_UNREADABLE, sprintf("attr:%s", k))] = "";
CS[concat(PC_UNREADABLE, "attrs")] = "";
CS[concat(PC_UNREADABLE, "marker_data")] = "";

// ---- mandatory start / end, and D13's overflow policy ----------------------
// D18: caps end a RUN, not a section - true at a spline end and at a
// `pc_section` limit, false at a corner.
string e_slot[];
int e_rule[], e_mod[];
string e_name[];
for (int side = 0; side < 2; side++) {
    if (side == 0 ? !SCAP : !ECAP) continue;
    string slot = side ? "end" : "start";
    dict cf0 = CF; cf0["index"] = 0.0;
    int rr, mi; string mn;
    pc_pick(slot, cf0, CS, 0, CURVE_ID, SEC_IX, YCLASS, rr, mi, mn);
    if (rr < 0) continue;
    push(e_slot, slot); push(e_rule, rr); push(e_mod, mi); push(e_name, mn);
}

int overflow = 0;
while (len(e_slot) > 1) {
    float tot = 0.0;
    for (int k = 0; k < len(e_mod); k++) tot += pc_m_len(e_mod[k]);
    for (int k = 0; k < len(e_mod) - 1; k++)
        tot += pc_m_pad(e_mod[k], 1) + pc_m_pad(e_mod[k + 1], 0);
    if (tot <= L + PC_PEPS) break;
    pop(e_slot); pop(e_rule); pop(e_mod); pop(e_name);   // drop `end` first
    overflow = 1;
}
float squeeze = 1.0;
if (len(e_slot)) {
    float tot = 0.0;
    for (int k = 0; k < len(e_mod); k++) tot += pc_m_len(e_mod[k]);
    for (int k = 0; k < len(e_mod) - 1; k++)
        tot += pc_m_pad(e_mod[k], 1) + pc_m_pad(e_mod[k + 1], 0);
    if (tot > L + PC_PEPS) {
        squeeze = L / pc_m_len(e_mod[0]);       // scale the survivor onto L
        overflow = 1;
    }
}

string warn_end = overflow ? PC_W_OVERFLOW : "";
int has_head = 0, has_tail = 0, head_mod = -1, tail_mod = -1;
float head_s1 = 0.0, tail_s0 = 0.0;
for (int k = 0; k < len(e_slot); k++) {
    float mlen = pc_m_len(e_mod[k]) * squeeze;
    float a, b;
    if (e_slot[k] == "start") { a = 0.0; b = mlen; has_head = 1;
                                head_mod = e_mod[k]; head_s1 = b; }
    else                      { a = L - mlen; b = L; has_tail = 1;
                                tail_mod = e_mod[k]; tail_s0 = a; }
    push(o_slot, e_slot[k]);
    push(o_index, 0);
    push(o_module, e_name[k]);
    push(o_variant, pc_m_variant(e_mod[k]));
    push(o_s0, a);
    push(o_s1, b);
    push(o_u, pc_u_at(SEC_S0, CURVE_L, a));
    push(o_scale, squeeze);
    push(o_slice, -1.0);
    push(o_deform, pc_m_deform(e_mod[k]));
    push(o_zmode, pc_zmode(e_mod[k]));
    push(o_warns, pc_warn_join(warn_end, pc_module_warns(e_mod[k], e_rule[k])));
}

float free_a = has_head ? head_s1 : TRIM_A;
float free_b = has_tail ? tail_s0 : (L - TRIM_B);
float lead_pad  = has_head ? pc_m_pad(head_mod, 1) : 0.0;
float trail_pad = has_tail ? pc_m_pad(tail_mod, 0) : 0.0;

// ---- the anchors: evenly, then markers (D15) -------------------------------
string a_slot[], a_module[], a_variant[], a_zmode[], a_warns[];
int a_index[], a_deform[];
float a_s0[], a_s1[], a_u[];

{
    dict cf0 = CF; cf0["index"] = 0.0;
    int rr, mi; string mn;
    pc_pick("evenly", cf0, CS, 0, CURVE_ID, SEC_IX, YCLASS, rr, mi, mn);
    if (rr >= 0) {
        // D15, corrected: the anchor divides the free span but the PIECE is
        // centred on it, so half a module comes off each GUARDED end -
        // subtracting only the padding lets the last evenly post grow through
        // the end cap.
        float half = pc_m_len(mi) * 0.5;
        float base = free_a + lead_pad
                     + (has_head ? (pc_m_pad(mi, 0) + half) : 0.0);
        float top = free_b - trail_pad
                    - (has_tail ? (pc_m_pad(mi, 1) + half) : 0.0);
        float ats[];
        pc_evenly(max(top - base, 0.0), ats);
        for (int i = 0; i < len(ats); i++) {
            float at = ats[i] + base;
            // the rule is re-read AT THE ANCHOR: 3.3 lists `u` as a
            // per-candidate subject and a sequence must walk per anchor
            dict cfi = CF;
            cfi["index"] = (float)i;
            cfi["u"] = pc_u_at(SEC_S0, CURVE_L, at);
            int ar, ami; string amn;
            pc_pick("evenly", cfi, CS, i, CURVE_ID, SEC_IX, YCLASS, ar, ami, amn);
            if (ar < 0) continue;
            float ahalf = pc_m_len(ami) * 0.5;
            push(a_slot, "evenly"); push(a_index, i);
            push(a_module, amn); push(a_variant, pc_m_variant(ami));
            push(a_s0, at - ahalf); push(a_s1, at + ahalf);
            push(a_u, pc_u_at(SEC_S0, CURVE_L, at - ahalf));
            push(a_deform, pc_m_deform(ami)); push(a_zmode, pc_zmode(ami));
            push(a_warns, pc_module_warns(ami, ar));
        }
    }
}

int mk_id[] = i[]@_mk_id;
float mk_s[] = f[]@_mk_s, mk_u[] = f[]@_mk_u;
dict mk_data[] = d[]@_mk_data;
dict m_index;
for (int j = 0; j < len(mk_id); j++) {
    string slot = sprintf("marker:%d", mk_id[j]);
    int seen = m_index[slot];
    dict cfi = CF, csi = CS;
    cfi["index"] = (float)seen;
    // the marker's OWN u, not the section start: a conditional marker rule
    // on `u` otherwise tests a position the marker is not at
    cfi["u"] = mk_u[j];
    if (j < len(mk_data)) {
        dict md = mk_data[j];
        // ⚠️ THE TYPE IS READ, NOT GUESSED, AND `json_dumps` IS WHY.  VEX has
        // no `dicttype`, and `typeid` is ambiguous on a dict slot (both
        // probed) - so this used to infer the type by READING: a cross-type
        // read answers "" or 0.0, and a datum whose value is the EMPTY STRING
        // was therefore indistinguishable from a numeric 0 and was taken as
        // numeric.  Measured on a 20 m fence with one marker carrying
        // `{"tag": ""}` and a `markerData:tag eq ""` rule, that put a 0.12 m
        // post where the reference puts a 1.6 m gate and shifted every piece
        // after it by 0.21 m.
        //
        // `json_dumps(dict, 0)` IS the missing introspection (probed on
        // 22.0.398): it emits
        //     {"a": {"type": "string", "value": ""}, "b": {"type": "float", ...
        // so one dump names the type of a slot.
        //
        // ⚠️ D242 - AND IT IS DUMPED ONE KEY AT A TIME, NOT ONCE PER MARKER.
        // The previous version searched the WHOLE marker's dump for the
        // literal text `"<k>": {"type": "string"`, which is the key's SOURCE
        // spelling and not its JSON spelling.  `json_dumps` escapes, so a key
        // containing a quote, a backslash or any non-ASCII character never
        // matched its own probe.  Measured on the shipped .hda, level 1 and
        // level 2 both admitting, 20 m line + one marker at 10 m:
        //   * `{'a"b': "x"}` with `markerData:a"b eq 0.0` - the miss read the
        //     string as 0.0 and fired a gate the artist never asked for
        //     (native 1 gate + 10 panels, reference 10 panels);
        //   * `{u"ké": "x"}` with `markerData:ké eq "x"` - the miss
        //     DROPPED the gate the artist did ask for, so the failure runs in
        //     both directions.
        // Dumping a ONE-KEY dict removes the key text from the question
        // entirely: the FIRST `"type": "` token in that dump is the slot's own
        // type, whatever the key is spelled like.  `removeindex` on a dict is
        // probed and is the only way to build it - `one[k] = md[k]` is an
        // ambiguous call to the array index operator.
        //
        // ⚠️ AND EVERY TYPE THAT IS NOT A SCALAR IS UNREADABLE, NOT A NUMBER.
        // The old `else` branch was `float v = md[k]`, so a vector, a list or
        // a nested dict cross-type-read as 0.0 and was published as a READABLE
        // NUMERIC subject where the reference holds a tuple/list/dict.
        // Measured: `{"v": (1.0, 2.0, 3.0)}` under `markerData:v eq 0.0` built
        // 1 gate + 10 panels natively against the reference's 10 panels, and
        // `lt`/`ge` diverged the same way.  The sentinel below is the answer
        // `pc_cond_subject` already models for an unreadable `attr:` name -
        // False under every ordered op and under `eq`, True under `ne`.
        //
        // ⚠️ AND THE FIRST TOKEN, NOT ANY TOKEN: a nested dict's dump carries
        // its CHILD's `"type"` too ({"d": {"type": "dict", "value": {"a":
        // {"type": "float"...), so a bare `pc_str_contains(tj, "float")` would
        // type the parent by its child.  `find` returns the first index.
        foreach (string k; keys(md)) {
            string key = sprintf("markerData:%s", k);
            dict one = md;
            foreach (string kk; keys(md)) if (kk != k) removeindex(one, kk);
            string tj = json_dumps(one, 0);
            int ti = find(tj, "\"type\": \"");
            string head = (ti < 0) ? "" : tj[ti + 9 : ti + 17];
            if (startswith(head, "string\"")) {
                string sv = md[k]; csi[key] = sv;
            } else if (startswith(head, "int\"") || startswith(head, "float\"")) {
                float v = md[k]; cfi[key] = v;
            } else {
                csi[concat(PC_UNREADABLE, key)] = "";
            }
        }
    }
    int rr, mi; string mn;
    pc_pick(slot, cfi, csi, seen, CURVE_ID, SEC_IX, YCLASS, rr, mi, mn);
    if (rr < 0) continue;
    m_index[slot] = seen + 1;
    float half = pc_m_len(mi) * 0.5, at = mk_s[j];
    push(a_slot, slot); push(a_index, seen);
    push(a_module, mn); push(a_variant, pc_m_variant(mi));
    push(a_s0, at - half); push(a_s1, at + half);
    push(a_u, pc_u_at(SEC_S0, CURVE_L, at - half));
    push(a_deform, pc_m_deform(mi)); push(a_zmode, pc_zmode(mi));
    push(a_warns, pc_module_warns(mi, rr));
}

// `anchors.sort(key=(s0, slot, index))` - insertion, N is the gate count
int na = len(a_slot);
int aord[];
for (int i = 0; i < na; i++) {
    push(aord, i);
    int j = i;
    while (j > 0) {
        int x = aord[j - 1], y = aord[j];
        int swap = 0;
        if (a_s0[x] > a_s0[y]) swap = 1;
        else if (a_s0[x] == a_s0[y]) {
            if (a_slot[x] > a_slot[y]) swap = 1;
            else if (a_slot[x] == a_slot[y] && a_index[x] > a_index[y]) swap = 1;
        }
        if (!swap) break;
        aord[j - 1] = y; aord[j] = x;
        j--;
    }
}
foreach (int i; aord) {
    push(o_slot, a_slot[i]); push(o_index, a_index[i]);
    push(o_module, a_module[i]); push(o_variant, a_variant[i]);
    push(o_s0, a_s0[i]); push(o_s1, a_s1[i]); push(o_u, a_u[i]);
    push(o_scale, 1.0); push(o_slice, -1.0);
    push(o_deform, a_deform[i]); push(o_zmode, a_zmode[i]);
    push(o_warns, a_warns[i]);
}

// ---- the default fill, in the gaps the anchors leave -----------------------
// D119 - the default rule is picked HERE rather than through `pick`, so
// without a row class a `yclass`-scoped default rule leaked onto every row.
int d_rules[];
pc_rules_for("default", YCLASS, d_rules);
if (len(d_rules)) {
    int rule = -1;
    foreach (int r; d_rules) {
        int gi, ok; string gn;
        dict cf0 = CF; cf0["index"] = 0.0;
        pc_choose(r, cf0, CS, "default", 0, CURVE_ID, SEC_IX, YCLASS, gi, gn, ok);
        if (ok) { rule = r; break; }
    }
    int idx = 0;
    float a = free_a, lead = lead_pad;
    int has_lead = has_head;
    // D244 - the pool and the slot context, ONCE for every gap this loop
    // fills.  Both are a pure function of (rule, yclass); see `pc_fill`.
    dict cs_slot = CS;
    cs_slot["slot"] = "default";
    int p_ci[], p_ord[]; string p_cn[]; float p_w[], p_total = 0.0;
    // `rule` is -1 when every default rule declined, which `pc_fill` answers
    // by returning `index0` - so the pool is not asked for either.
    if (rule >= 0)
        pc_pool(rule, pc_role_2d("default", YCLASS), p_ci, p_cn, p_ord, p_w,
                p_total);
    // D19: only a closed section with NOTHING else on it wraps as one run.
    int cyclic = CLOSED && !na && !len(e_slot);
    for (int k = 0; k <= na; k++) {
        int last = (k == na);
        int ai = last ? -1 : aord[k];
        float b = last ? free_b : a_s0[ai];
        // the anchor's own pad pushes its neighbours, this run included
        float trail = last ? trail_pad : pc_m_pad(pc_kit_by_name(a_module[ai]), 0);
        int has_trail = last ? has_tail : 1;
        // ⚠️ FRESH ARRAYS PER CALL, AND THAT IS D243 - THE ONE CHANGE THAT
        // TOOK THIS NODE FROM QUADRATIC TO LINEAR IN THE ANCHOR COUNT.
        // `pc_fill`'s twelve plan arrays are `export`, so VEX copies each of
        // them IN and OUT on every call; passing the accumulating plan made
        // one call cost the whole plan built so far, and an `evenly` or
        // `marker` rule calls once per gap.  Measured on the shipped asset,
        // `hou.perfMon` Cook-ms on this node, 2 km straight at four
        // `Evenly Spacing` values: 1 277.6 / 3 041.4 / 12 414.0 / 47 168.1 ms
        // for 2 501 / 3 001 / 6 001 / 12 001 pieces - doubling the anchors
        // QUADRUPLED the node, and the end-to-end 2 km cook was 39.5 s
        // against the reference's 0.48 s (82x SLOWER than the Python this
        // port replaced, on a MAIN-page parm the guard admits).  Isolated:
        // stubbing the `pc_fill` call and leaving the anchor loop and the
        // insertion sort in place restored linear growth, so the sort the
        // comment above calls out is NOT the cost - the copy is.
        //
        // ⚠️ AND IT IS SEMANTICALLY IDENTICAL, WHICH IS WHY IT IS SAFE.
        // `pc_fill` reads its incoming arrays exactly once, as
        // `int entry = len(o_slot)` (pc_plan.h), and resizes back to that on
        // D11's tile retry; every other use is `push`.  A fresh array of
        // length 0 is that same contract with entry = 0, and the pieces it
        // pushed are appended after it returns.  Measured with the same
        // fixtures: 243.6 / 273.0 / 533.8 / 1 161.8 ms (5.2x / 11.1x / 23.3x
        // / 40.6x), growth back to linear, and the plan bit-identical at all
        // four sizes.
        string f_slot[], f_module[], f_variant[], f_zmode[], f_warns[];
        int f_index[], f_deform[];
        float f_s0[], f_s1[], f_u[], f_scale[], f_slice[];
        idx = pc_fill(a, b, rule, CF, CS, CURVE_ID, SEC_IX, SEC_S0, CURVE_L,
                      YCLASS, idx, lead, has_lead, trail, has_trail,
                      "", "", cyclic,
                      p_ci, p_cn, p_ord, p_w, p_total, cs_slot,
                      f_slot, f_index, f_module, f_variant, f_s0, f_s1, f_u,
                      f_scale, f_slice, f_deform, f_zmode, f_warns);
        append(o_slot, f_slot);       append(o_index, f_index);
        append(o_module, f_module);   append(o_variant, f_variant);
        append(o_s0, f_s0);           append(o_s1, f_s1);
        append(o_u, f_u);             append(o_scale, f_scale);
        append(o_slice, f_slice);     append(o_deform, f_deform);
        append(o_zmode, f_zmode);     append(o_warns, f_warns);
        if (last) break;
        a = a_s1[ai];
        lead = pc_m_pad(pc_kit_by_name(a_module[ai]), 1);
        has_lead = 1;
    }
}

// ⚠️ THIS NODE IS THE WHOLE OF D307, RE-MEASURED BY THE C4 AUDIT (F2).
// `Stage = output` is 2.62x `Stage = reference` on ONE LONG CURVE with no
// surface (20 km, 66 666 pieces) and 0.31x on 300 short streets, and the split
// is here: `pc_plan_solve` is 4 531 ms of a 4 887 ms cook - 93 % - at 68
// us/piece against the whole Python reference's 27.  Scaling was measured
// too: curve LENGTH and VERTEX COUNT are irrelevant (30 us/piece at 1 segment
// and at 960); PIECE COUNT on one curve takes it 30 -> 68.  The 101x gap
// between 1 curve and 256 curves for identical total work is that plus THREAD
// COUNT - this is a per-SECTION wrangle, so one curve gets one thread and
// there is nothing to harvest.  The shape to look at is below: twelve
// parallel dynamic arrays grown by `append` once per piece, merge-sorted, and
// copied into twelve more.  `output_guard_cost` holds the ceiling meanwhile.
//
// ---- `out.sort(key=(s0, slot, index))` -------------------------------------
int n = len(o_slot);
int ord[], buf[];
resize(ord, n); resize(buf, n);
for (int i = 0; i < n; i++) ord[i] = i;
int width = 1;
while (width < n) {
    for (int lo = 0; lo < n; lo += 2 * width) {
        int mid = min(lo + width, n), hi = min(lo + 2 * width, n);
        int x = lo, y = mid, o = lo;
        while (x < mid || y < hi) {
            int take;
            if (x >= mid)     take = 0;
            else if (y >= hi) take = 1;
            else {
                int p = ord[x], q = ord[y];
                if (o_s0[p] != o_s0[q])            take = (o_s0[p] < o_s0[q]);
                else if (o_slot[p] != o_slot[q])   take = (o_slot[p] < o_slot[q]);
                else                               take = (o_index[p] <= o_index[q]);
            }
            buf[o] = take ? ord[x++] : ord[y++];
            o++;
        }
    }
    for (int i = 0; i < n; i++) ord[i] = buf[i];
    width *= 2;
}

// ---- and the permutation is APPLIED ONLY WHEN THERE IS ONE ----------------
//
// The sort itself is free (measured: disabling it changes nothing), but the
// copy that applies its answer - twelve `push()` calls per piece into twelve
// parallel local arrays - ran on every fill whether `ord` permuted anything
// or not, and on an ordinary run it does not: `_p_index` reads (0, 1, 2, 3,
// ...) on a straight fence, so the merge sort's answer is the IDENTITY and
// the copy reproduces the order it was already in.  Measured on the rig,
// `pc_plan_solve` alone, best of 3 dirtied passes with `cookCount` asserted:
// 2 500 pieces 25.6 -> 22.3 us/piece (13 % off the node) and 10 000 pieces
// 29.7 -> 24.2 us/piece (18 % off, 5.5 us/piece), with `_p_s0`, `_p_index`
// and `_p_row` bit-identical.  A 20 km fence was paying ~0.055 s of pure
// array shuffling for no change in its output.
//
// The ANCHOR and MARKER cases are where the permutation is genuinely
// non-trivial and both branches have to agree; `plan_fixture_parity` and
// `plan_stress_parity` run them.
int _perm = 0;
for (int i = 0; i < n; i++) if (ord[i] != i) { _perm = 1; break; }

string p_slot[], p_module[], p_variant[], p_zmode[], p_warns[];
int p_index[], p_deform[];
float p_s0[], p_s1[], p_u[], p_scale[], p_slice[];
if (!_perm) {
    p_slot = o_slot; p_index = o_index; p_module = o_module;
    p_variant = o_variant; p_s0 = o_s0; p_s1 = o_s1; p_u = o_u;
    p_scale = o_scale; p_slice = o_slice; p_deform = o_deform;
    p_zmode = o_zmode; p_warns = o_warns;
} else {
    foreach (int i; ord) {
        push(p_slot, o_slot[i]); push(p_index, o_index[i]);
        push(p_module, o_module[i]); push(p_variant, o_variant[i]);
        push(p_s0, o_s0[i]); push(p_s1, o_s1[i]); push(p_u, o_u[i]);
        push(p_scale, o_scale[i]); push(p_slice, o_slice[i]);
        push(p_deform, o_deform[i]); push(p_zmode, o_zmode[i]);
        push(p_warns, o_warns[i]);
    }
}

// ---- the five STRING arrays leave as a TABLE plus an index -----------------
//
// ⚠️ THIS IS 7x ON THIS NODE AND IT WAS THE WHOLE OF THE PORT'S SPEED DEFECT.
// Measured on a 20 km / 20 000-piece single-section fence: the solve cost
// **0.96 s** against `plan.plan_sections` - the PYTHON it replaced - at
// **0.053 s**, twenty times slower, and stubbing the five `s[]@_p_*` writes
// alone took it to **0.134 s**.  So the cost is not the fill loop, not the
// sort and not the array pushes (all measured, all small): it is that a VEX
// STRING ARRAY ATTRIBUTE costs ~9 microseconds PER ELEMENT to write, and five
// of them at 20 000 pieces is 100 000 elements.
//
// Nothing had measured it. `bench_plan_long_curve` says in as many words that
// it asserts no ceiling, and D193's ceilings this cycle landed on
// `pc_plan_emit` and `pc_stamp`, which do not write string arrays.
//
// The five values are massively repetitive - `slot` is "default" for a whole
// run, and `module`/`variant`/`zmode`/`warns` come from a unit of one or two
// modules - so they go out as a small DEDUPED table plus one int per piece.
// The scan is a fast path on the PREVIOUS row (consecutive pieces almost
// always share one) and a linear scan of the table otherwise.
//
// `PC_ROW_MAX` is the escape hatch and it is not decoration: a plan whose
// rows really are all distinct would make that scan quadratic, so past the
// cap the arrays go out exactly as they did before and `pc_plan_emit` reads
// them directly. `plan_row_table_spills` exercises that branch.
#define PC_ROW_MAX 256
string t_slot[], t_module[], t_variant[], t_zmode[], t_warns[];
int p_row[];
resize(p_row, n);
int nrow = 0, last = -1, spill = 0;
for (int i = 0; i < n; i++) {
    int r = -1;
    if (last >= 0 && p_slot[i] == t_slot[last] && p_module[i] == t_module[last]
            && p_variant[i] == t_variant[last] && p_zmode[i] == t_zmode[last]
            && p_warns[i] == t_warns[last]) {
        r = last;
    } else {
        for (int j = 0; j < nrow; j++) {
            if (p_slot[i] == t_slot[j] && p_module[i] == t_module[j]
                    && p_variant[i] == t_variant[j] && p_zmode[i] == t_zmode[j]
                    && p_warns[i] == t_warns[j]) { r = j; break; }
        }
    }
    if (r < 0) {
        if (nrow >= PC_ROW_MAX) { spill = 1; break; }
        push(t_slot, p_slot[i]); push(t_module, p_module[i]);
        push(t_variant, p_variant[i]); push(t_zmode, p_zmode[i]);
        push(t_warns, p_warns[i]);
        r = nrow;
        nrow++;
    }
    p_row[i] = r;
    last = r;
}
if (spill) {
    resize(p_row, 0);
    s[]@_p_slot = p_slot;
    s[]@_p_module = p_module;
    s[]@_p_variant = p_variant;
    s[]@_p_zmode = p_zmode;
    s[]@_p_warns = p_warns;
} else {
    s[]@_p_slot = t_slot;
    s[]@_p_module = t_module;
    s[]@_p_variant = t_variant;
    s[]@_p_zmode = t_zmode;
    s[]@_p_warns = t_warns;
}
i[]@_p_row = p_row;
i[]@_p_index = p_index;
i[]@_p_deform = p_deform;
f[]@_p_s0 = p_s0;
f[]@_p_s1 = p_s1;
f[]@_p_u = p_u;
f[]@_p_scale = p_scale;
f[]@_p_slice = p_slice;
i@_npieces = n;
f@_sec_length = L;
