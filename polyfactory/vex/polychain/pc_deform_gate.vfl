// STAGE 4 - PLACE + DEFORM (spec 4.4), THE DEFORM GATE.  13.9 N5.
//   POINT wrangle over PLAN POINTS, precision 64.
//   input 0  the plan, carrying `pc_proto`'s module numbers
//   input 1  CONFIG
//   input 2  the DECOMPOSED spline (the sampler table)
//
// `place._needs_deform` ported: ONE rule, in ONE place, deciding whether a
// piece ships as a packed instance or as rebuilt geometry.  It is the single
// most expensive thing left in the Python kernel on the shape citygen and
// PC-G3 actually run - profiled on the 20 km fence, `_needs_deform` plus
// `span_deviation` is 0.133 s of `place.build`'s 0.813 s, more than the
// fitting solve and the packed transform put together - and it is what
// decides whether 10 005 pieces cost 0.42 s and 12 MB or 21.9 s and 360 180
// points (D69).
//
// THE REFERENCE'S ORDER, KEPT EXACTLY, because every line of it is a decision
// somebody had to make twice:
//
//   1. a SLICED piece or one carrying a corner cut always deforms (D41 - a
//      miter unpacks). `pc_sliced` is the plan's own flag; a corner cut
//      cannot reach here at all, because 4.3 is not ported and a case with
//      corners is out of scope by name.
//   2. an ANCHORED piece never does - it is a straight corner leg. Anchors
//      come only from `corner.py`, so the same sentence applies.
//   3. `pc_deform <= 0` never does (D27) - the module said it is rigid.
//   4. a D99 BAND with ground under it always does - a band is a per-point
//      rule and a packed prim is one matrix. NOT PORTED, and this node
//      DECLARES ITSELF UNANSWERABLE rather than guessing (see below).
//   5. the CURVATURE BUDGET (D75/D87): `span_deviation > bend_tol`.
//   6. 4.5's drape test - a dead-straight spline over a ridge has no interior
//      vertex, so the budget above says "nothing to follow". Needs the
//      conform (N6), and the same declaration covers it.
//   7. `vertical`: a SHEARED span deforms, whatever the plan curve did.
//
// ⚠️ AND WHAT IT REFUSES TO ANSWER IS AN ATTRIBUTE, NOT A COMMENT.  Steps 4
// and 6 need a band and a surface this graph has not ported, and a gate that
// silently answered "packed" for them would be the exact failure the rebuild
// is most at risk of: a green suite over a tool that quietly stopped
// segregating.  `pc_frame_valid` already carries `pc_proto`'s refusal for a
// surface, a fillet, a slope fix and D98's flatten; this adds D99's band to
// it, so an unanswerable piece is DROPPED by `pc_place_valid` exactly as
// those are, and `Stage = output` keeps the reference for that build.

#include "pc_gate.h"

int    pr    = i@pc_curveprim;
float  sa    = f@pc_ws0;
float  sb    = f@pc_ws1;
string zmode = s@pc_zmode;

dict cfg = detail(1, "pc_cfg");
float tol = 0.01;
if (isvalidindex(cfg, "bend_tol")) { float v = cfg["bend_tol"]; tol = v; }
string band_side = "";
if (isvalidindex(cfg, "flat_band")) { string v = cfg["flat_band"]; band_side = v; }
float band_m = 0.0;
if (isvalidindex(cfg, "flat_band_m")) { float v = cfg["flat_band_m"]; band_m = v; }

// `place._band` returns None for exactly these three reasons, and this is
// that test rather than a re-derivation of it: no side chosen, a zero height,
// or an `adaptive` piece (it rides the full frame, so it has no flat half to
// hold). Whether the band reaches into the module is `_band`'s fourth test
// and it does not change the answer here - `_needs_deform` only asks WHETHER
// there is a band, and a band that swallows the module is still a band.
int has_band = ((band_side == "top" || band_side == "bottom")
                && band_m > PC_EPS && zmode != "adaptive");

// D87: the budget is spent by the piece's WORST POINT, not by its spine.
// `adaptive` rolls y and z with the frame, a yaw-only mode keeps y world-
// vertical, so the reach off the spine is the full radius in one case and the
// z half in the other.
float radius = (zmode == "adaptive") ? f@_proto_radius : f@_proto_rz;

float dev = 0.0;
int needs = 0;
if (i@pc_sliced) {
    needs = 1;
} else if (i@pc_deform > 0) {
    dev = pc_span_deviation(2, pr, sa, sb, radius, zmode);
    if (dev > tol) {
        needs = 1;
    } else if (zmode == "vertical") {
        vector a, ta, b, tb;
        pc_span_ends(2, pr, sa, sb, a, ta, b, tb);
        needs = (abs(b.y - a.y) > 1e-6);
    }
}

// ⚠ THE ANSWER IS `pc_deformed`, WHICH IS 3.4's OWN NAME FOR IT, AND THAT
// IS NOT A CONVENTION VIOLATION.  13.3.4 asked for a point group called
// `pc_needs_deform`; conventions.md 2 says an internal is `_*` and `_scrub`
// deletes it before OUT - so an `_*` gate answer is invisible at
// `Stage = gate`, which is the one place an artist would go to ask WHY a run
// unpacked. This node computes exactly 3.4's `pc_deformed`, one build stage
// early, so it publishes it under that name and `pc_finalize` writes the same
// attribute on the built prim. `_gate_dev` stays `_*`: the metres are a
// diagnostic, not contract.
f@_gate_dev    = dev;
i@pc_deformed  = needs;
// the two the branch cannot answer, folded into the flag `pc_place_valid`
// already blasts on.  `pc_gate_valid` stays as its own attribute - beside
// `pc_frame_valid`, for the same reason and by the same rule - so a check can
// tell "this piece is packed" from "this piece was never judged".
int gate_valid = (i@pc_frame_valid && !has_band);
i@pc_gate_valid = gate_valid;
if (!gate_valid) i@pc_frame_valid = 0;
if (has_band && @ptnum == 0)
    warning("polyChain: the native deform gate cannot answer a build with a Flat Band - D99's band is a per-point rule and 13.9 N5's deformed branch is not ported. Set Stage = Output for the full result.");
