// STAGE 4 - PLACE (spec 4.4), THE MODULE'S OWN NUMBERS.  POINT wrangle, 64.
//   input 0  the NATIVE plan (one point per piece)
//   input 1  CONFIG
//   input 2  IN_KIT
//
// `place.Proto`'s two load-bearing fields, read off the kit instead of off a
// Python object: the module's nominal FITTED length and its local origin.
// Without them `pc_frames` had to be fed by `pc_plan_bridge`, which is the
// Python 13.9 N2 exists to delete.
//
//   pc_proto_len  `module.length` (3.2's `pc_size.x`), and the bbox X extent
//                 when that is zero or absent - D20's "the fitted size is not
//                 the bounding box", with the documented fallback.
//   pc_proto_ax   the source bbox MIN X.  D20 again: geometry outside
//                 [minX, minX + size.x] legitimately OVERHANGS and is carried
//                 along, so the fit origin is the bbox minimum and not 0.
//
// ⚠️ WHAT THIS NODE DOES NOT ANSWER, AND WHY IT SAYS SO RATHER THAN GUESSING.
// `pc_frames` also reads `pc_yscale` (E2's row band - phase 2), `pc_upref`
// (D55's camber, which comes from 4.5's surface normal) and `pc_basey` (D98's
// flatten-under).  All three are the identity in a phase-1 build with no
// surface and no flatten, and NONE of them is derivable here - so
// `pc_frame_valid` is 0 whenever the build asks for one of them, and the
// branch drops the piece rather than drawing it in the wrong place.  That is
// warn-never-block for a half-ported graph, exactly as D160 wrote it for the
// bridge.

#include "pc_path.h"

// ⚠️ THE KIT IS WALKED BACKWARDS, AND THE DIRECTION IS THE WHOLE POINT.
// `Kit._by_name` is a dict comprehension, so a REPEATED `pc_name` is won by
// the LAST module carrying it - `pc_kit_by_name` (pc_plan.h) already walks
// backwards for that reason, and `copytopoints`' own `useidattrib` was
// measured to pick the last too.  This loop ran FORWARDS, so on a kit with
// two prims named "post" the plan fitted one module and the copy pasted the
// other: measured on three 0.5 / 1.0 / 2.0 m prims all named "post", the
// reference built 10 pieces 2.0000 m long and this branch built them
// 8.0000 m long (2.0 m of geometry x a scale computed from the 0.5 m one),
// with no warning and no error.  Reversing the kit payload made the error
// disappear, which is what an order dependence looks like.
string want = s@pc_module;
int n = nprimitives(2);
float plen = 1.0, pax = 0.0;
float pry = 0.0, prz = 0.0, py0 = 0.0, py1 = 0.0;
int found = 0;
for (int i = n - 1; i >= 0; i--) {
    string name = prim(2, "pc_module", i);
    if (name != want) continue;
    int pts[] = primpoints(2, i);
    if (!len(pts)) continue;
    vector size = point(2, "pc_size", pts[0]);
    float bb[] = primintrinsic(2, "bounds", i);
    pax = len(bb) ? bb[0] : 0.0;
    float extent = len(bb) ? (bb[1] - bb[0]) : 1.0;
    plen = (size.x > PC_EPS) ? size.x : max(extent, PC_EPS);
    // 13.9 N5 - HOW FAR THIS MODULE REACHES OFF THE SPINE, which is what
    // D87's curvature budget is actually spent by. `_Proto` takes these off
    // the SOURCE bounding box and not off `pc_size`, because the nominal
    // fitted size is a contract about the FIT while the bbox is the geometry
    // that will actually move; `bounds` on the packed prim is that same box.
    // `y0`/`y1` are D99's band interval, in the module's own local Y - which
    // is also world metres, since the fit scales along x only.
    if (len(bb) >= 6) {
        pry = max(abs(bb[2]), abs(bb[3]));
        prz = max(abs(bb[4]), abs(bb[5]));
        py0 = bb[2];
        py1 = bb[3];
    }
    found = 1;
    break;
}

f@pc_proto_len = plen;
f@pc_proto_ax  = pax;
// `_*` because none of these is 3.4 output contract - they exist for the
// deform gate one node down (conventions.md 2, so `_scrub` clears them).
// `adaptive` rolls y AND z with the frame; a yaw-only mode keeps y world-
// vertical (`place._frame`), so there only z rides it.
f@_proto_radius = sqrt(pry * pry + prz * prz);
f@_proto_rz     = prz;
f@_proto_y0     = py0;
f@_proto_y1     = py1;
f@pc_yscale    = 1.0;                    // E2 is phase 2; the identity here
v@pc_upref     = set(0.0, 1.0, 0.0);     // D55's camber needs 4.5's normal
i@pc_has_basey = 0;                      // D98's flatten-under needs 4.5 too

// 3.4's stand-in is a real answer, not a failure - but this node cannot
// MEASURE one, because a missing module has no geometry in the kit.  The
// piece is declared unanswerable rather than placed at a guessed size.
dict cfg = detail(1, "pc_cfg");
int has_surface = 0;
if (isvalidindex(cfg, "has_surface")) { float v = cfg["has_surface"]; has_surface = (int)v; }
float fillet = 0.0;
if (isvalidindex(cfg, "fillet_radius")) { float v = cfg["fillet_radius"]; fillet = v; }
float fix_slope = 0.0;
if (isvalidindex(cfg, "fix_slope")) { float v = cfg["fix_slope"]; fix_slope = v; }
float flatten = 0.0;
if (isvalidindex(cfg, "flatten_stepped")) { float v = cfg["flatten_stepped"]; flatten = v; }

// The four the CONFIG decides for the WHOLE build, so this test is the same
// answer on every point - which is what makes the node warning below sound.
int unported = (has_surface || fillet > 0.0 || fix_slope != 0.0
                || flatten != 0.0);
i@pc_frame_valid = (found && !unported);
// ⚠ `setpointattrib` AND NOT `i@`, AND THE DIFFERENCE IS THE OUTPUT'S
// SCHEMA.  A bound write creates the attribute whether or not the branch
// runs, so every build published `pc_warn_kit_gap` on every element - where
// the reference DECLARES a warning attribute only when the build actually
// raised it (`place._declare`).  Measured by `place_stamp_parity` on six
// cases with a perfectly good kit: the attribute was there, reading 0, and
// the reference's output had no such attribute at all.
if (!found) setpointattrib(0, "pc_warn_kit_gap", @ptnum, 1);

// ⚠️ AN EMPTY STAGE HAS TO SAY WHY IT IS EMPTY.  `pc_place_valid` blasts
// every piece this node could not answer for, so with a surface, a fillet, a
// slope fix or D98's flatten in the build the native PLACE branch shipped
// ZERO prims with `node.warnings()` EMPTY - the same silent-empty failure
// 16.4 point 3 had already fixed once for the unwired input, in a new place.
// D177 said this branch "declares what it cannot answer", and it did - onto a
// point attribute that `pc_place_valid` then deleted, so the declaration
// reached nobody.  `warning()` puts it on the NODE, which is where an artist
// staring at an empty viewport can read it; the attribute stays for the
// checks.  ONE point raises it because `unported` is a per-build answer.
if (unported) {
    // INTERNAL, and named for it (conventions.md 2). It is this BRANCH
    // saying it cannot answer, not one of 3.4's per-element warnings, and
    // published as `pc_warn_*` it rode onto every output prim where the
    // reference has no such attribute. `_scrub` removes it before OUT.
    i@_warn_stage_unported = 1;
    if (@ptnum == 0)
        warning("polyChain: the native PLACE branch cannot answer this build - a surface, a fillet radius, a slope fix or a stepped flatten needs spec 4.5, which is not ported yet (13.9 N5/N6). Set Stage = Output for the full result.");
}
