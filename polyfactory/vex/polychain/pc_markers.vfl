// STAGE 1 - DECOMPOSE (spec 4.1), markers.  POINT wrangle.
//   input 0  the spline stream (marker points AND curve prims live here)
//   input 1  CONFIG
//
// `Marker.distance_on` ported, with its two easily-lost details:
//   * the total is the RAW cumulative length (`pc_total`, closing segment
//     included), not `_clean`'s length - they differ by up to 1e-6 m per
//     merged vertex and the marker check asserts at 1e-9;
//   * D35 - a zero `pc_dist` beside a real `pc_u` is the geometry-wide
//     DEFAULT, not an authored 0.  Reading it as authored built a
//     0.75-of-the-curve gate at s = 0, silently.
// Out-of-range values are CLAMPED, which is `distance_on`'s last line.

#include "pc_path.h"

if (!i@pc_marker) return;

// -1 until this marker is BOUND. The attribute's own default is 0, and 0 is
// a real primitive number, so an unbound marker used to be indistinguishable
// from one sitting on prim 0.
i@pc_curveprim = -1;

// D168 - a DICT lookup, not a scan.  The stored value is prim + 1 so that an
// absent key (0) and prim 0 are different answers.
string cid = s@pc_curve;
if (cid == "") { i@pc_warn_marker_unbound = 1; return; }
dict byid = detail(0, "pc_curve_prim");
int slot = byid[cid];
if (slot <= 0) { i@pc_warn_marker_unbound = 1; return; }
int pr = slot - 1;

// D169 - TWO CURVES WITH ONE ID.  The reference places the marker on BOTH of
// them (`resolve_markers` filters by id, not by prim); one point wrangle can
// only move the point it is on.  So this stage answers for the FIRST prim
// claiming the id and says so, rather than being quietly short by one gate.
// D74 already warns about the duplicate id itself.
dict dupids = detail(0, "pc_curve_dup");
int dup = dupids[cid];
if (dup) i@pc_warn_marker_dup = 1;

float total = prim(0, "pc_total", pr);

int has_u    = haspointattrib(0, "pc_u");
int has_dist = haspointattrib(0, "pc_dist");
float u    = has_u    ? point(0, "pc_u", @ptnum)    : 0.0;
float dist = has_dist ? point(0, "pc_dist", @ptnum) : 0.0;
if (has_dist && has_u && abs(dist) <= 0.0) has_dist = 0;      // D35

float s;
if (has_dist)   s = (dist >= 0.0) ? dist : total + dist;
else if (has_u) s = u * total;
else            s = 0.0;
s = clamp(s, 0.0, total);

f@pc_s         = s;
f@pc_u         = (total <= PC_EPS) ? 0.0 : s / total;
i@pc_curveprim = pr;
