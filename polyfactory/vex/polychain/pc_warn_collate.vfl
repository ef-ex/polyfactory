// STAGE 6 - FINALIZE (spec 4.6), THE WARNING SUMMARY.  DETAIL wrangle, 64.
//   input 0  the built prims, carrying `_warns` per element
//   input 1  `config` - the flattened rule table (D88, below)
//   input 2  OUT_sections - the decomposed spline (D88, below)
//
// D61 - "collate warnings", as a detail array of "name:count", plus the
// per-element fan-out.  Two jobs in one node because both need the same scan
// and the scan is what costs.
//
// ⚠️ ONE THREAD, ON PURPOSE, AND IT IS THE SAME REASON `pc_plan_emit` IS A
// DETAIL WRANGLE.  `setprimattrib` with a name that comes from DATA creates
// the attribute at runtime, and the order attributes are created in a
// multithreaded wrangle is thread order - the values would be right and the
// output's attribute LIST could differ between two cooks of one build, which
// is exactly the kind of thing `geometry_digest` is pinned on.  One thread,
// one order.  The scan is a string read per prim; the fan-out only touches
// elements that actually carry a warning.
//
// ⚠️ AND `pc_warnings` EXISTS EVEN WHEN IT IS EMPTY.  `place._collate_warnings`
// declares the attribute unconditionally, so a build with nothing to say
// still publishes an empty array - and the guard switch that hands this
// branch to `Stage = output` compares the two schemas, not just their values.
//
// `pc_kit_warnings` is EMPTY here and that is a DECLARED limit, not an
// omission: the kit-level class (a kit missing `kitId`, a duplicate module
// name) is `kit.read`'s validation, which is Python and stays Python (13.6).
// `config` refuses the native path outright when the kit warns, so this array
// is empty exactly when it is allowed to be - `native_ok` is where that is
// enforced and `output_guard_parity` is what proves it.

int n = hasprimattrib(0, "_warns") ? nprimitives(0) : 0;
dict counts;
for (int i = 0; i < n; i++) {
    string w = prim(0, "_warns", i);
    if (w == "") continue;
    foreach (string name; split(w)) {
        if (name == "") continue;
        setprimattrib(0, name, i, 1);
        int c = counts[name];
        counts[name] = c + 1;
    }
}

string keys[] = sort(keys(counts));
string summary[];
foreach (string k; keys) {
    int c = counts[k];
    push(summary, sprintf("%s:%d", k, c));
    // ⚠️ AND ON THE NODE, NOT ONLY IN THE ATTRIBUTE.  `hda.cook` ends with
    // `node.addWarning("%s on %d elements")` for every warning the build
    // raised, and that is what an artist sees without middle-clicking
    // anything.  A native output does not cook `kernel`, so without this line
    // the guard would take a build and silently drop its warnings - the
    // wording is `hda.cook`'s own, so the two paths say the same sentence.
    warning("%s on %d elements", k, c);
}
s[]@pc_warnings = summary;
string none[];
s[]@pc_kit_warnings = none;

// ---------------------------------------------------------------------------
// D88's UNREAD-MARKER WARNING, ON THE NATIVE PATH.
//   input 1  `config` (the flattened rule table and `pc_cfg`)
//   input 2  OUT_sections (the decomposed spline - the marker points)
//
// ⚠️ THE MARKER REFUSAL WAS NEVER ABOUT GEOMETRY, IT WAS ABOUT THIS SENTENCE.
// 4.2's marker anchors have been at parity since N2 - `plan_solve_parity`
// runs the marker cases - but `hda._warn_unread_markers` raises D88's warning
// from `hda.cook`, on the `kernel` node, and a native output never cooks that
// node.  So `pc_envelope.vfl` refused every build with a marker in it purely
// to keep the warning, measured at **52 ms of Python on a 2 km run and 212 ms
// on 300 streets** - the biggest thing in this tool that was Python for want
// of a string.  PART B moved the sentence instead.
//
// ⚠️ AND PART B PUT IT ONE NODE TOO FAR UP, WHICH THIS NODE FIXES.  It went
// into `pc_sections`, the first node of the native PLAN chain, on the premise
// that "this chain only cooks when level 1 has admitted the build, which is
// exactly when `kernel` is silent".  That premise stopped being true in the
// same cycle that wrote it: PART B also widened level 1, so there is now a
// whole class of build that level 1 ADMITS and level 2 REFUSES - and on those
// the plan chain cooks (`pc_envelope2` needs it) AND `kernel` cooks, so the
// artist read the identical sentence twice.  Measured on the shipped asset
// with a loose marker of id 7: `straight` -> `pc_sections` alone, correct;
// `arc R=20 step 0.05` and `arc R=50 step 0.1` - `guard_bend_bound`'s own two
// L2-refusal fixtures - -> `pc_sections` AND `kernel`, the same words.
//
// ⚠️ THE COOK MAP IS WHAT PICKS THIS NODE, not taste.  Over the three
// scenarios the `cookCount`s are:
//     node               native   L1-admit/L2-refuse   Stage = reference
//     pc_sections           1              1                   0
//     copy_packed .. this   1              0                   0
//     kernel                0              1                   1
// This node and `kernel` are exact complements, so the warning is raised
// EXACTLY ONCE on every build, from whichever branch actually shipped it.
// `unread_marker_warns` asserts that on three fixtures now, the third being
// the arc, and `_first_difference` cannot see a warning so nothing else would.
//
// The message is `_warn_unread_markers`' own, word for word, including which
// of the two faces authored the style - a warning that reads differently
// depending on which node raised it is a warning an artist cannot search for.
int mk_ids[];
if (haspointattrib(2, "pc_marker")) {
    int has_id = haspointattrib(2, "pc_marker_id");
    int npt = npoints(2);
    for (int i = 0; i < npt; i++) {
        int flag = point(2, "pc_marker", i);
        if (flag != 1) continue;
        int id = has_id ? point(2, "pc_marker_id", i) : 0;
        if (find(mk_ids, id) < 0) push(mk_ids, id);
    }
}
if (len(mk_ids)) {
    // which ids a `marker:<id>` rule actually READS.  `pc_r_slot` is CONFIG's
    // flattened rule table - the same array `pc_plan.h` selects on - so this
    // asks the resolved STYLE and not the parameter page, which is what makes
    // it answer the same way under a wired payload (D77).
    string slots[] = detail(1, "pc_r_slot");
    int read_ids[];
    foreach (string slot; slots) {
        // VEX has no `strncmp`; the slice IS the prefix test.
        if (slot[0:7] != "marker:") continue;
        string tail = slot[7:];
        // `atoi` answers 0 for junk, and 0 is a REAL marker id (it is the
        // default `pc_marker_id`), so a slot whose tail is not a number must
        // not be read as reading marker 0.  `_warn_unread_markers` reaches
        // the same answer with `except ValueError: continue`.
        if (tail == "" || tail != itoa(atoi(tail))) continue;
        push(read_ids, atoi(tail));
    }
    int unread[];
    foreach (int id; sort(mk_ids))
        if (find(read_ids, id) < 0) push(unread, id);
    if (len(unread)) {
        string parts[];
        foreach (int id; unread) push(parts, itoa(id));
        dict cfg_w = detail(1, "pc_cfg");
        int from_payload = 0;
        if (isvalidindex(cfg_w, "from_payload")) {
            float v = cfg_w["from_payload"];
            from_payload = (int)v;
        }
        warning("input 1 carries markers with id %s and no rule reads them - %s",
                join(parts, ", "),
                from_payload ? "add a marker:<id> rule to the style payload"
                             : "set Marker Id and Piece at Marker");
    }
}
