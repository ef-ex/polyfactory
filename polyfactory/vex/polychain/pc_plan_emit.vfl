// STAGE 2 - PLAN (spec 4.2), THE MATERIALISATION.  DETAIL wrangle, 64.
//   input 0  the SOLVE output - one point per section, carrying the plan as
//            per-section arrays
//   input 1  CONFIG
//
// One point per piece, plus 3.4's stamp.
//
// ⚠️ THIS NODE REPLACES 13.3.2's `pointgenerate` + read PAIR, AND THE REASON
// IS A MEASUREMENT, NOT A PREFERENCE.  D150 chose `pointgenerate` because
// `addpoint` from a MULTITHREADED wrangle emits in thread-completion order,
// which would make `determinism` and `geometry_digest` a lottery.  That
// reasoning is still right and it does not apply here: a DETAIL wrangle has
// ONE thread, so the emission order is the loop's order, exactly as
// `pc_sections` already relies on.
//
// What `pointgenerate` costs is quadratic.  It copies the SECTION's
// attributes onto every point it generates, and the plan is twelve ARRAYS of
// one element per piece - so a section of N pieces copies 12 x N elements N
// times, and the read then binds all twelve on every one of those points
// again.  Measured on the 20 km fence, one section:
//
//     pieces   solve      expand + read     total
//      2 000   0.113 s      1.9 s            2.1 s
//     10 000   0.55  s     38.0 s           38.6 s
//
// The SOLVE is linear (0.113 / 0.229 / 0.469 / 0.956 s as the piece count
// doubles); everything above it was the copy.  Reading each section's arrays
// ONCE and emitting from them is linear, and it is what 15.6 predicted when
// it wrote "N2's per-section arrays will hit the same wall `pc_seg_*` hit".
//
// The section points stay in the stream carrying `_is_section = 1` and
// `pc_plan_only` blasts them.
//
// ⚠️ THAT DOES NOT DELETE THE ARRAYS, AND THE COMMENT HERE USED TO SAY IT
// DID - "nothing downstream sees an array attribute".  A blast removes
// POINTS, not attribute definitions, so all twelve per-section arrays ride
// every piece point to the end of the graph; measured at `Stage = plan_native`
// they were all still on the point-attribute list.  They are `_*` names now,
// so `_scrub` before OUT removes them for free (conventions.md 2), and the
// next implementer reading this will not reuse a pattern that does not work -
// which matters at N5, where `pc_stations` carries arrays that are NOT empty.

#include "pc_plan.h"

int nsec = npoints(0);
for (int sp = 0; sp < nsec; sp++) {
    int npieces = point(0, "_npieces", sp);
    if (npieces <= 0) continue;

    // ⚠️ ONCE PER SECTION.  Hoisting these twelve reads out of the piece loop
    // IS the fix - an array read copies the whole array, so doing it per
    // piece is the quadratic the `pointgenerate` version paid.
    // ⚠ THE FIVE STRING ARRAYS ARE A DEDUPED TABLE NOW, NOT ONE ENTRY PER
    // PIECE, and `_p_row` is the index into it.  The solve's own comment
    // carries the measurement: a VEX string ARRAY attribute costs ~9 us per
    // ELEMENT to write, so five of them at 20 000 pieces was 0.83 s of a
    // 0.96 s node.  A plan with more distinct rows than the table may hold
    // SPILLS - the arrays come through per piece exactly as they used to and
    // `_p_row` is empty, which is what `via_row` reads.
    string p_slot[]    = point(0, "_p_slot", sp);
    string p_module[]  = point(0, "_p_module", sp);
    string p_variant[] = point(0, "_p_variant", sp);
    string p_zmode[]   = point(0, "_p_zmode", sp);
    string p_warns[]   = point(0, "_p_warns", sp);
    int    p_row[]     = point(0, "_p_row", sp);
    int    via_row     = (len(p_row) == npieces);
    int    p_index[]   = point(0, "_p_index", sp);
    int    p_deform[]  = point(0, "_p_deform", sp);
    float  p_s0[]      = point(0, "_p_s0", sp);
    float  p_s1[]      = point(0, "_p_s1", sp);
    float  p_u[]       = point(0, "_p_u", sp);
    float  p_scale[]   = point(0, "_p_scale", sp);
    float  p_slice[]   = point(0, "_p_slice", sp);

    string curve_id = point(0, "pc_curve_id", sp);
    int    sec_ix   = point(0, "pc_sec_index", sp);
    float  sec_s0   = point(0, "pc_sec_s0", sp);
    float  curve_l  = point(0, "pc_curve_len", sp);
    int    curveprim = point(0, "pc_curveprim", sp);
    float  sec_key  = point(0, "_sec_key", sp);
    // D7's section key is whatever type the artist authored - `read_curves`
    // reads it back untyped and `Placement.section_key` carries it through.
    // A Houdini attribute is geometry-wide, so exactly one of these two
    // branches ever runs in a build.
    int    sec_kind = point(0, "_sec_key_kind", sp);
    string sec_key_s = point(0, "_sec_key_s", sp);
    string style_key = point(0, "_style_key", sp);
    string yclass   = point(0, "pc_yclass", sp);
    // 4.3 item F / D46 - `corner._stamp_degenerate`, ported.  ONCE PER
    // SECTION, like the twelve above and for the same reason: an array read
    // copies the whole array.  Empty on every build with no dissolved
    // degenerate corner, which is almost all of them.
    float degen_s[] = point(0, "_degen_s", sp);
    int   c_closed  = point(0, "_curve_closed", sp);
    int   ndeg      = len(degen_s);

    int n = via_row ? npieces : min(npieces, len(p_slot));
    for (int k = 0; k < n; k++) {
        int rw = via_row ? p_row[k] : k;
        float s0 = p_s0[k], s1 = p_s1[k];
        int pt = addpoint(0, set(sec_s0 + s0, 0.0, 0.0));

        setpointattrib(0, "pc_curve_id",  pt, curve_id);
        setpointattrib(0, "pc_sec_index", pt, sec_ix);
        setpointattrib(0, "pc_sec_s0",    pt, sec_s0);
        setpointattrib(0, "pc_curve_len", pt, curve_l);
        setpointattrib(0, "pc_curveprim", pt, curveprim);
        if (sec_kind == 2) setpointattrib(0, "pc_section", pt, sec_key_s);
        else               setpointattrib(0, "pc_section", pt, sec_key);
        // ⚠ AND 3.4's OWN `pc_section` IS A DIFFERENT NUMBER FROM THE ONE
        // ABOVE.  The reference calls the attribute `pc_section` twice with
        // two meanings: on a PLAN POINT it is the artist's section KEY
        // (`Placement.as_dict`), and on the built PRIM it is the section
        // INDEX as an int (`_stamp_values`).  This branch published the KEY,
        // as a float, on every prim - measured on a 30 m run sectioned 5/7/9,
        // all 36 prims read 5.0 / 7.0 / 9.0 where the reference reads 0/1/2 -
        // and nothing saw it, because `place_packed_parity` compared `P` and
        // the world bounds and no check compared the stamp at all.
        // `_sec_out` is what `copy_packed` carries and `pc_finalize` turns
        // into the output attribute; the `_` prefix is conventions.md 2, so
        // `_scrub` removes it before OUT with no edit there.
        setpointattrib(0, "_sec_out", pt, sec_ix);
        setpointattrib(0, "pc_style",     pt, style_key);
        setpointattrib(0, "pc_yclass",    pt, yclass);

        setpointattrib(0, "pc_slot",    pt, p_slot[rw]);
        setpointattrib(0, "pc_index",   pt, p_index[k]);
        setpointattrib(0, "pc_module",  pt, p_module[rw]);
        setpointattrib(0, "pc_variant", pt, p_variant[rw]);
        setpointattrib(0, "pc_zmode",   pt, p_zmode[rw]);
        setpointattrib(0, "pc_deform",  pt, p_deform[k]);
        setpointattrib(0, "pc_scale",   pt, p_scale[k]);
        setpointattrib(0, "pc_u",       pt, p_u[k]);

        // SECTION-LOCAL metres are the truth for everything inside 4.2 (D16);
        // the world station is the section's own start plus them, in 64 bits -
        // which is what deletes D170's float32 head-plus-residual pair here.
        setpointattrib(0, "pc_s0",  pt, s0);
        setpointattrib(0, "pc_s1",  pt, s1);
        setpointattrib(0, "pc_len", pt, s1 - s0);
        setpointattrib(0, "pc_ws0", pt, sec_s0 + s0);
        setpointattrib(0, "pc_ws1", pt, sec_s0 + s1);

        // -1 is Python's `slice_t = None`: this piece was not cut.
        setpointattrib(0, "pc_slice_t", pt, p_slice[k]);
        setpointattrib(0, "pc_sliced",  pt, (p_slice[k] >= 0.0) ? 1 : 0);

        // ⚠️ 3.4's STAMP IS NOT HERE ANY MORE - IT IS `pc_stamp`, THE NEXT
        // POINT WRANGLE.  `sprintf` plus `pc_elem_key`'s per-byte crc32 is
        // the one embarrassingly parallel part of this node, and this node is
        // single-threaded by construction (D150).  Measured at 10 000 pieces:
        // stubbing `pc_elem_key` alone took the plan chain from 0.777 s to
        // 0.596 s, so 23 % of the emit was one hash on one core.
        // every warning the solve raised, as its own int attribute - the
        // shape `place` / `hda` already publish and `colour_warnings` reads
        //
        // ⚠️ THE ROW STRING IS NOT MUTATED, AND THAT IS THE WHOLE CARE HERE.
        // `p_warns` is the DEDUPED table (`_p_row`), so two pieces can share
        // one row while only ONE of them spans the dissolved vertex; writing
        // the stamp back into `p_warns[rw]` would warn the other piece too.
        // The reference APPENDS at the end of the tuple and skips a placement
        // that already carries it, which is what `pc_warn_join` /
        // `pc_warn_has` spell.
        string warns = p_warns[rw];
        if (ndeg && !pc_warn_has(warns, PC_W_CORNERDEG)) {
            float a = sec_s0 + s0, b = sec_s0 + s1;
            int hit = 0;
            foreach (float sv; degen_s) {
                // `_stamp_degenerate`'s own `reps`, and its bounds are
                // INCLUSIVE - a piece that merely ENDS on the vertex is
                // stamped too (D68's note).
                if (a - PC_PEPS <= sv && sv <= b + PC_PEPS) { hit = 1; break; }
                if (!c_closed) continue;
                float up = sv + curve_l, dn = sv - curve_l;
                if ((a - PC_PEPS <= up && up <= b + PC_PEPS)
                    || (a - PC_PEPS <= dn && dn <= b + PC_PEPS)) {
                    hit = 1; break;
                }
            }
            if (hit) warns = pc_warn_join(warns, PC_W_CORNERDEG);
        }
        setpointattrib(0, "pc_warns", pt, warns);
        foreach (string w; split(warns))
            setpointattrib(0, w, pt, 1);
    }
}
