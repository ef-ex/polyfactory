// STAGE 1 - DECOMPOSE (spec 4.1).  PRIMITIVE wrangle, VEX precision 64.
//
// One curve per thread; the cumulative scan is sequential INSIDE that thread.
// That is the decomposition the data actually has.
//
// ⚠️ IT IS NOT A SPEEDUP AND THE HEADER USED TO SAY IT WAS.  This line
// claimed "0.0037 s against the reference's 0.030 s"; that number timed a
// wrangle writing ONE point attribute, not this node, which also builds the
// 20 000-element sampler table.  `decompose_long_curve_wall_clock` measures
// the whole stage against the whole reference answer on every run and prints
// the ratio; 15.2 carries the reading.
//
// 64-BIT IS MANDATORY HERE.  This is the 20 km expression 11.0 measured
// returning 0 at 32 bits; `vex_precision = 64` stores the result as a FLOAT64
// attribute, so the value reaches the next node undamaged.
//
// It writes TWO tables, because the reference has two and they are not the
// same table:
//   * the SAMPLER table (`_seg_hi` / `_seg_i` per VERTEX, `_nseg` /
//     `pc_total` / `pc_closed` / `_first` per prim) is `place.Path`: raw
//     vertices, zero-length segments dropped at 1e-9, the closing segment
//     appended for a closed curve.
//   * the CLEAN table (`pc_s` per point, `pc_seclen` per prim) is
//     `decompose._clean`: coincident vertices merged at 1e-6, and a closed
//     curve's repeated final vertex dropped.
// Collapsing them would be wrong by 1e-6 m in the places it matters most.

#include "pc_path.h"

// D167 - a prim `place.read_curves` DECLINED is not a curve here either, and
// it gets no table at all.  `pc_curveid` made the decision; repeating the
// test would be a second copy of a rule that has already drifted once.
if (!i@pc_iscurve) return;

int pts[] = primpoints(0, @primnum);
int np = len(pts);
int closed = primintrinsic(0, "closed", @primnum);

// ---- the SAMPLER table: place.Curve._cumulative + Curve._segments ----------
vector P[];
resize(P, np);
for (int i = 0; i < np; i++) P[i] = point(0, "P", pts[i]);

// ⚠️ RESIZE ONCE, THEN INDEX. Never `append` in a loop this long. Measured
// on this exact fixture - a 20 km line at 1 m, 20 001 vertices - the append
// version of the four tables below cooked in 0.0442 s against 0.0428 s for
// this one at 20 km, and 0.0044 s against 0.0028 s on the same shape at 2 km;
// `append` reallocates, and five arrays growing one element at a time is most
// of what the node was doing at the shorter length.
// The arrays are cut back to their real length at the end, which is one
// reallocation instead of twenty thousand.
int ncum = np + ((closed && np > 1) ? 1 : 0);
float cum[];
resize(cum, ncum);
cum[0] = 0.0;
float total = 0.0;
for (int i = 1; i < np; i++) {
    total += length(P[i] - P[i - 1]);
    cum[i] = total;
}
if (closed && np > 1) {
    total += length(P[0] - P[np - 1]);
    cum[np] = total;
}

float seg_hi[];
int seg_i[];
resize(seg_hi, ncum - 1);
resize(seg_i, ncum - 1);
int nseg = 0;
for (int i = 0; i < ncum - 1; i++) {
    vector a = P[i];
    vector d = P[(i + 1) % np] - a;
    if (length(d) >= PC_EPS) {          // a duplicated point is not a segment
        seg_hi[nseg] = cum[i + 1];
        seg_i[nseg] = i;
        nseg++;
    }
}
resize(seg_hi, nseg);
resize(seg_i, nseg);

// ⚠️ THE SAMPLER TABLE IS PER-VERTEX STORAGE, NOT FOUR PER-PRIM ARRAYS, AND
// THAT IS THE SINGLE BIGGEST MEASUREMENT OF THIS CYCLE.  A `prim()` read of an
// ARRAY attribute COPIES THE WHOLE ARRAY, and `pc_sample` did four of them on
// every call - twice per piece.  On the 20 km fixture (20 001 vertices,
// 18 870 pieces) that is 160 000 values copied per sample x 2 x 18 870 =
// 3.2e9 value copies, and it measured as `pc_frames_native` 4 833 ms against
// `copy_packed`'s 5.1 ms - while 16.5 blamed `copytopoints` for "roughly two
// of those three seconds".  Scaling the curve 250 m -> 20 km, the node grew
// ~4x per doubling (pieces x segments) where the linear stages grew 2x.
//
// A per-VERTEX attribute is read one scalar at a time - `vertex(inp, name,
// prim, j)` - so the bisect is ~15 indexed reads and the sample is four more.
// Segment j lives on VERTEX j of the same primitive, which always fits:
// `nseg <= ncum - 1 <= primvertexcount`.  This is the same defect D175 fixed
// in `pointgenerate` (an attribute copy that is quadratic in the thing being
// iterated), shipped unfixed in the node beside it.
//
// 13.5's OpenCL transliterability is kept and arguably improved: indexed
// reads into one flat table are what OpenCL wants anyway.
//
// TWO columns, not four.  `_seg_lo` is `_seg_hi[j - 1]` exactly - a dropped
// segment has zero length, so `cum` does not advance across it and the kept
// segments stay contiguous in arclength, and `seg_lo[0]` is 0.0 because
// `cum[0]` is 0 and any dropped prefix is zero-long.  And the segment's two
// VECTORS are not stored at all: `_seg_i` is the VERTEX the segment starts
// at, so `a` is `P` there and `d` is `P` at the next vertex minus it - the
// same float32 positions this wrangle just read, so the arithmetic downstream
// is bit-for-bit what it was.  Two values per vertex instead of seven, which
// is what keeps `decompose_long_curve_wall_clock` where it was: the table is
// no longer four BULK array writes, it is a per-vertex loop, and a loop that
// writes seven values costs what it says.
int nvtx = primvertexcount(0, @primnum);
for (int j = 0; j < nseg; j++) {
    if (j >= nvtx) break;               // cannot happen; a silent guard
    setvertexattrib(0, "_seg_hi", @primnum, j, seg_hi[j]);
    setvertexattrib(0, "_seg_i",  @primnum, j, seg_i[j]);
}
i@_nseg       = nseg;
f@pc_total    = (len(cum) ? cum[len(cum) - 1] : 0.0);
i@pc_closed   = closed;
v@_first      = (np ? P[0] : set(0.0, 0.0, 0.0));

// ---- the CLEAN table: decompose._clean -------------------------------------
// `keep[k]` is the k-th surviving VERTEX SLOT (an index into `pts`), which is
// what `_clean` calls its "kept original indices".
int keep[];
resize(keep, np);
int nk = 0;
for (int i = 0; i < np; i++) {
    if (nk && length(P[i] - P[keep[nk - 1]]) <= PC_POS_EPS) continue;
    keep[nk] = i;
    nk++;
}
if (closed && nk > 1
        && length(P[keep[0]] - P[keep[nk - 1]]) <= PC_POS_EPS) {
    nk--;                               // the closing vertex, not a second one
}
resize(keep, nk);

// A vertex the clean pass merged away carries -1 and its predecessor's metre,
// so a downstream read of `pc_s` on ANY point is still a metre on this curve.
// ⚠️ THESE ARE PER-(CURVE, VERTEX) QUANTITIES IN POINT STORAGE, which is only
// sound because `pc_unshare` runs first (D165).  Without it a junction point
// shared by two prims is written twice and one curve silently carries the
// other's metre - measured on a fused pair, a 90 deg corner vanished and the
// numbers flipped with primitive order alone.
// ⚠️ ONE pass, not two: a `setpointattrib` written earlier in the same wrangle
// is NOT guaranteed readable back, so the running metre is carried in a local.
int kpos[];
resize(kpos, np);
for (int i = 0; i < np; i++) kpos[i] = -1;
for (int k = 0; k < nk; k++) kpos[keep[k]] = k;

float ccum = 0.0, held = 0.0;
for (int i = 0; i < np; i++) {
    int k = kpos[i];
    if (k < 0) {
        setpointattrib(0, "pc_s",        pts[i], held);
        setpointattrib(0, "pc_cleanidx", pts[i], -1);
        setpointattrib(0, "pc_prev",     pts[i], -1);
        setpointattrib(0, "pc_next",     pts[i], -1);
        continue;
    }
    if (k) ccum += length(P[i] - P[keep[k - 1]]);
    held = ccum;
    setpointattrib(0, "pc_s",        pts[i], ccum);
    setpointattrib(0, "pc_cleanidx", pts[i], k);
    setpointattrib(0, "pc_prev", pts[i],
                   (closed || k > 0)      ? pts[keep[(k - 1 + nk) % nk]] : -1);
    setpointattrib(0, "pc_next", pts[i],
                   (closed || k < nk - 1) ? pts[keep[(k + 1) % nk]] : -1);
}

f@pc_seclen = ccum;                      // the CLEANED length (4.1's section)
i@pc_nclean = nk;
