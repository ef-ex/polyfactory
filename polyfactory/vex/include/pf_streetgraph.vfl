#ifndef __pf_streetgraph_vfl__
#define __pf_streetgraph_vfl__

// CityGen - street graph helpers.
// Design: ideas/citygen_streets.md
//
// Runtime lives in VEX, not Python: these run per element on every cook, and
// the HOM geometry API is single threaded.  Python is reserved for things that
// are not geometry - preset authoring and report formatting.
//
// Junction vocabulary follows CityEngine's connection classes. That is a
// naming convention, not a dependency.

#define PFSG_STREET      "STREET"
#define PFSG_CROSSING    "CROSSING"
#define PFSG_JUNCTION    "JUNCTION"
#define PFSG_DEAD_END    "DEAD_END"
#define PFSG_PORTAL      "PORTAL"
#define PFSG_ROUNDABOUT  "ROUNDABOUT"


// Arc length of a polyline primitive.
float pfsg_primlength(const int geo, prim) {
    float total = 0.0;
    int pts[] = primpoints(geo, prim);
    for (int i = 1; i < len(pts); i++) {
        // explicit vector locals: point() is untyped, so distance() would be
        // ambiguous between its vector2/vector/vector4 overloads
        vector a = point(geo, "P", pts[i - 1]);
        vector b = point(geo, "P", pts[i]);
        total += distance(a, b);
    }
    return total;
}


// Topological class of a node from its degree.
// Degree 2 is a pass-through, even where two streets meet end to end: that is
// geometrically a corner but topologically not a junction.
string pfsg_nodeclass(const int degree; const int is_portal) {
    if (is_portal)    return PFSG_PORTAL;
    if (degree <= 1)  return PFSG_DEAD_END;
    if (degree == 2)  return PFSG_STREET;
    if (degree == 3)  return PFSG_JUNCTION;
    return PFSG_CROSSING;
}


// Is this primitive a dead-end edge shorter than min_len?
// Used by the prune loop; iterative because removing one stub exposes the next.
int pfsg_is_short_stub(const int geo, prim; const float min_len) {
    int pts[] = primpoints(geo, prim);
    if (len(pts) < 2) return 1;
    int d0 = neighbourcount(geo, pts[0]);
    int d1 = neighbourcount(geo, pts[-1]);
    if (d0 != 1 && d1 != 1) return 0;
    return pfsg_primlength(geo, prim) < min_len;
}


// Stable, deterministic element id.  Hierarchical so a pasted region is a
// prefix rewrite (citygen.md Contract 1), and derived from a canonical sort
// key rather than cook order so unrelated edits do not renumber it.
string pfsg_elem_id(const string prefix; const string kind; const int index) {
    return sprintf("%s/%s_%05d", prefix, kind, index);
}


// Position at arc length `d` along a polyline primitive.
// Needed because a cleaned-up street is often just two points: anything that
// walks VERTICES rather than LENGTH will place nothing between them.
vector pfsg_pos_at_length(const int geo, prim; const float d) {
    int pts[] = primpoints(geo, prim);
    if (len(pts) == 0) return {0, 0, 0};
    float acc = 0;
    for (int i = 1; i < len(pts); i++) {
        vector a = point(geo, "P", pts[i - 1]);
        vector b = point(geo, "P", pts[i]);
        float s = distance(a, b);
        if (acc + s >= d)
            return lerp(a, b, s > 1e-9 ? (d - acc) / s : 0.0);
        acc += s;
    }
    return vector(point(geo, "P", pts[-1]));
}


// Unit forward tangent of the polyline segment that contains arc length `d`.
// This is the frame the SWEEP uses at a trimmed end - its terminal
// cross-section lies across this segment - so a junction mouth built from it
// is parallel to the road it caps. Using the node tangent instead rotates the
// mouth by the whole turn of the polyline over the trim distance (up to 30.9
// degrees, measured), which wedges a triangular hole open at the seam.
//
// The `>` is deliberate and does NOT match pfsg_pos_at_length's `>=`. That
// function answers "where is the point at `d`", which is the same point from
// either side of a vertex. This one answers "which segment will s5j_trim leave
// as the road's TERMINAL one", and a cut landing exactly on a vertex keeps that
// vertex and ends on the segment AFTER it. Aligning the two comparisons cost B
// eleven collapsed corner segments and three downward faces.
vector pfsg_tangent_at_length(const int geo, prim; const float d) {
    int pts[] = primpoints(geo, prim);
    int n = len(pts);
    vector last = {0, 0, 0};
    float acc = 0;
    for (int i = 1; i < n; i++) {
        vector a = point(geo, "P", pts[i - 1]);
        vector b = point(geo, "P", pts[i]);
        vector s = b - a;
        float sl = length(s);
        if (sl < 1e-9) continue;
        last = s / sl;
        if (acc + sl > d) return last;
        acc += sl;
    }
    return last;
}


// Push a trim distance forward until the road's TERMINAL segment is at least
// `minseg` long.
//
// s5j_trim inserts the cut inside a resample segment and the road's last
// segment then runs from the cut to that segment's far vertex - so a cut
// landing just short of the vertex leaves a sliver. Measured on C: 0.028 m
// against a 13.4 m half-width, and a ribbon swept along a segment that short
// folds. That is 4e-7, and it is what `no_sweep_fold_after_trim` reports; the
// two folds turn 0.3 and 4.0 degrees, so they are not sharp turns at all.
//
// It has to be fixed by moving the CUT, not the points. The junction mouth is
// square to the tangent of the segment CONTAINING the cut, so anything that
// ends the road on a different segment - deleting the sliver's far vertex, or
// snapping the cut onto it - rotates the road's terminal cross-section away
// from the mouth and re-opens the 4h-1 seam. Both were tried: C went from 0.003
// to 0.48 m, 53 of 135 ends out of tolerance. Keeping the cut inside one
// segment is the invariant the whole seam rests on.
//
// Trimming MORE is always safe: the fillet tangents stay inside the cut and the
// mouth moves out with it. `d` is measured from the polyline's start when
// `atstart`, from its end otherwise, and the result is never less than `d`.
//
// ⚠️ TRIMMING MORE IS SAFE ONLY UP TO THE LENGTH OF THE STREET, and the first
// version of this did not bound it. When the cut landed within `minseg` of the
// FAR end of the polyline, `min(acc[i] + minseg, L)` returned `L` and the mirror
// branch returned `0.0` - either way the whole street was consumed, `s5j_trim`
// deleted it at `ts + te >= 0.98 L`, and the junction kept a mouth opening onto
// nothing. That is 4e-3 reconstructed by a different route. It was never
// triggered but the margin was one push wide: B prim 29 is a 19.6 m local with
// 17.40 m trimmed - 2.18 m standing, 1.18 m from the cliff - and E's binding
// 20 m arm had already dropped from 4.80 to 3.00 m of road. So the push is now
// capped at `L - minseg`, and when there is no room to advance the cut STAYS
// where it was: a sliver of a terminal segment is a fold, but a deleted street
// under a live mouth is a hole in the city, and the fold is the lesser one.
// `trim_leaves_road_standing` asserts the margin instead of assuming it.
float pfsg_clear_of_vertex(const int geo, prim, atstart; const float d, minseg) {
    int pts[] = primpoints(geo, prim);
    int n = len(pts);
    if (n < 2 || minseg <= 0.0) return d;
    float acc[];
    resize(acc, n);
    acc[0] = 0.0;
    for (int i = 1; i < n; i++) {
        vector a = point(geo, "P", pts[i - 1]);
        vector b = point(geo, "P", pts[i]);
        acc[i] = acc[i - 1] + distance(a, b);
    }
    float L = acc[n - 1];
    if (L <= 0.0) return d;

    float s = atstart ? d : L - d;                  // the cut, from the start
    for (int i = 1; i < n; i++) {
        if (acc[i] <= s) continue;                  // the segment holding the cut
        // the push must leave `minseg` of road standing, and if it cannot then
        // it does not happen at all - see the warning above
        // ...and it must not create a worse sliver than the one it is fixing.
        // The push is a single unchecked jump to `acc[i] +/- minseg`, so on any
        // segment shorter than 2 x minseg it lands closer to the NEXT vertex
        // than it started from the last one: an audit brute-forced 1778 pushes
        // and found 780 leaving under a metre, worst 0.2 m from a 1.2 m
        // segment. Not reachable while s5_resample is 4 m, but the push is
        // pointless when it does not clear the vertex it is aiming past.
        if (atstart) {
            float push = acc[i] + minseg;
            if (acc[i] - s < minseg && push <= L - minseg
                && i + 1 < n && acc[i + 1] - push >= minseg) s = push;
        } else {
            float push = acc[i - 1] - minseg;
            if (s - acc[i - 1] < minseg && push >= minseg
                && i >= 2 && push - acc[i - 2] >= minseg) s = push;
        }
        break;
    }
    // never consume road the caller did not already ask for
    return min(max(atstart ? s : L - s, d), max(d, L - minseg));
}


// ---------------------------------------------------------------------------
// S3b - the centreline curvature clamp.
//
// A node where exactly two streets meet is not a junction, it is a street
// turning a corner, and S3b solves it on the CENTRELINE so the sweep just
// follows: the outer kerb comes out at R + halfwidth and the inner at
// R - halfwidth on their own. Built as 4f-4's curvature clamp, because a sharp
// turn is only curvature far over the clamp - one mechanism for both.
//
// ⚠️ THE FIRST VERSION OF THIS DID NOT SOLVE ANYTHING. It was an explicit
// Jacobi diffusion, `iters = 200` hardcoded, whose only exit was "nothing is
// over the clamp any more" - it could not tell a converged answer from a
// stalled one, so a non-converged centreline shipped silently. An audit ran it
// on the plain 90 degree arterial bend S3b was written for (80 + 80 m,
// W = 26.8, resampled 4 m) and measured kappa x R_min after
// 10 / 50 / 200 / 1000 / 5000 sweeps: 4.366 / 3.383 / 2.169 / 1.031 / 1.000.
// At the shipped 200 that is a delivered radius of 26.8 / 2.169 = 12.4 m
// against a 13.4 m half-width - INSIDE S3b's own inversion floor, where the
// inner kerb turns itself inside out. Every case in the suite only ever asked
// it for a few degrees, so all five sat at exactly 1.000 and it looked solved.
//
// Two independent defects, and both are fixed here:
//
//  1. O(k^2). Only vertices ALREADY over the clamp moved, so the corrected
//     region grew by about one vertex per sweep. Spreading 90 degrees over the
//     >= 11 vertices a 26.8 m R_min needs at 4 m spacing therefore took
//     thousands of sweeps. Cured twice over: the run is SEEDED with the
//     tangent arc S3b actually specifies (exact in one pass for an isolated
//     corner), and what relaxation is left spreads each correction over the
//     whole span the excess turn needs instead of one vertex.
//
//  2. Divergence, and segments collapsing to zero. `phimax` is proportional to
//     the local segment lengths and the correction pulls the vertex toward the
//     chord, which SHORTENS those very segments - smaller phimax, larger
//     correction, shorter still, with no lower bound. On a fold-back (a 30 m
//     square returning to within 4 m of its own start) the shipped loop went
//     4.37 -> 22.7 (200) -> 5320 (5000) and left a 1.0e-6 m segment in the
//     shipped graph, which is 4e-7's defect arriving from the other direction.
//     Cured by re-parametrising to uniform spacing every sweep, which makes
//     every segment L/(n-1) so one scalar test bounds them all, and by keeping
//     the BEST iterate rather than the last so a diverging sequence cannot
//     ship its worst state.
//
// The fold-back is not a solver failure, it is an infeasible input: R = 26.8 m
// needs 26.8 m of tangent run either side of a right angle and the sides are
// 30 m long, so no polyline through those pinned endpoints satisfies the clamp
// while remaining a street. The honest answer is to report it, which is what
// `converged` is for - `centreline_curvature_within_class` then sees a flagged
// non-convergence instead of a silently mangled centreline.
//
// RE-INTEGRATION IS STILL A RELAXATION and still has to be. Both ends of a
// street are NODES and may not move; integrating a clamped curvature from one
// end lands the far end elsewhere, and the closure correction that puts it back
// is a similarity whose scale multiplies the curvature straight back through
// the clamp. Everything below leaves both endpoints exactly where the graph
// put them.

// Signed turn at b, positive counter-clockwise in XZ, with the two edge
// lengths. Returns 0 when either edge is degenerate.
float pfsg_turn_at(const vector a, b, c; export float l1, l2) {
    vector e1 = b - a, e2 = c - b;
    l1 = length(e1);
    l2 = length(e2);
    if (l1 < 1e-9 || l2 < 1e-9) return 0.0;
    vector u = e1 / l1, v = e2 / l2;
    return atan2(cross(u, v).y, dot(u, v));
}


// Worst discrete curvature x R_min over a polyline. 1.0 IS the clamp, and this
// is deliberately the same expression `centreline_curvature_within_class`
// measures - a solver that converges to a different metric than the check is
// not a solver.
float pfsg_turn_residual(const vector P[]; const float rmin; const int closed) {
    int n = len(P);
    if (n < 3) return 0.0;
    float worst = 0.0;
    int lo = closed ? 0 : 1, hi = closed ? n : n - 1;
    for (int i = lo; i < hi; i++) {
        float l1, l2;
        float phi = abs(pfsg_turn_at(P[(i - 1 + n) % n], P[i], P[(i + 1) % n], l1, l2));
        if (l1 < 1e-9 || l2 < 1e-9) continue;
        float r = phi / (0.5 * (l1 + l2)) * rmin;
        if (r > worst) worst = r;
    }
    return worst;
}


// PER-VERTEX TURN CEILING = the class clamp, tightened by a CURVATURE-NOISE
// bound. 4f-4's mechanism is "resample -> discrete curvature -> SMOOTH kappa ->
// clamp to 1/R_min(class) -> re-integrate", and it names curvature noise in the
// traced polyline as "loudest by far" among the things that read as CG. Only
// the clamp half was ever built, and the two are different criteria:
//
//   MEASURED on C_radial's ring-closure seam. The weld leaves a single-vertex
//   19.0 deg turn against a 2.0 deg median. The clamp fires once, brings it to
//   13.4 deg -- R = 16.9 m against R_min = 14.4 m -- and then stops, because by
//   RADIUS it is now legal. `centreline_curvature_within_class` read 0.852 and
//   PASSED while the artist could see the corner in a 100 m radius ring.
//   A radius floor cannot catch a spike that clears the floor; only a bound
//   relative to the vertex's own neighbourhood can.
//
// So a vertex may turn at most `gain` times the mean turn of the vertices
// within +/-PFSG_SMOOTH_W of it, OR the MEDIAN turn of that same window with the
// vertex itself included, whichever is larger. Four properties make this safe
// rather than a general smoother:
//   * UNIFORM CURVATURE IS A FIXED POINT, AT EVERY gain > 0 -- a polyline whose
//     every interior vertex turns the same comes back untouched. The median
//     term is what buys that, and it is not decoration -- see the audit note
//     below. Independently re-measured 2026-08-10 on uniform arcs at
//     kappa x R_min 0.20 .. 0.95, open and closed: 0.000 m moved in 0 sweeps at
//     every gain from 0 to 8, with real spikes still caught.
//   * A VERTEX IS NEVER ASKED TO TURN LESS THAN ITS OWN NEIGHBOURHOOD'S LOWER
//     MEDIAN, so the bound can only ever bind on a vertex in the upper half of
//     its own window.
//   * IT NEVER LOOSENS THE CLASS CLAMP -- it is a `min` with it.
//   * IT HAS A FLOOR of `PFSG_SMOOTH_FLOOR` x the class allowance, so an
//     isolated corner in a dead-straight run (a 90 deg bend before the arc seed
//     runs, where the neighbourhood mean is 0) asks for a bounded radius rather
//     than an infinite one.
// `gain <= 0` disables the noise half entirely and restores the class-only
// behaviour exactly, which is how the A/B for this change was measured.
//
// ⚠️ AND HERE IS WHAT THOSE FOUR PROPERTIES DO NOT SAY. This comment used to
// add "...and it is why this cannot flatten a curve that is simply curved",
// and an independent audit of `812d55f` measured that false. "In the upper half
// of its own window" is NOT the same as "is a spike". Two cases, both measured:
//
//   * A SHORT CURVE IS TREATED AS A KINK, BY CONSTRUCTION. For a run of k
//     equally turning vertices between straight legs the ratio is
//     `6 / (gain x (k - 1))`, capped by the floor at
//     `kappa x R_min / PFSG_SMOOTH_FLOOR`. At the shipped gain of 2 that bites
//     for k <= 3, i.e. any curve shorter than ~12 m at the 4 m graph spacing:
//     a 14.5 deg turn drawn over 3 vertices -- R = 47.3 m against a 26.8 m
//     R_min, kappa x R_min = 0.566, legal by radius with room to spare -- is
//     bound at ratio 1.50 and flattened. k >= 4 puts the vertex's own turn AT
//     the lower-median slot of the 7-wide window, so its ceiling equals its own
//     turn exactly and the bound never binds at ANY gain. The threshold of 4 is
//     the +/-PFSG_SMOOTH_W window width, not the choice of median.
//
//   * A MONOTONICALLY TIGHTENING SPIRAL BINDS AT ITS TRAILING END, at gain <= 1.
//     `pfsg_median_lower` takes index (m-1)/2, and in a TRUNCATED end window
//     every other member is smaller than this vertex's own turn, so the lower
//     median lands two positions below it. Measured on a 24-vertex spiral
//     turning 1 -> 7 deg per vertex at 4 m spacing, R_min 26.8 m: the last three
//     interior vertices bind at 1.044 / 1.042 / 1.084 at every gain in
//     0.25 .. 1.0, mirror-symmetrically at the LEADING end when it tightens the
//     other way, and nowhere at all from gain 1.25 up. The consequence is mild
//     and self-healing -- the audit measured 9 cm of movement, converging to
//     1.010 -- and the trade is deliberate: taking the LOWER median is what
//     makes a truncated window err toward smoothing rather than toward letting a
//     spike through, and that is precisely what makes the spiral bind. Both
//     cannot be true at once. The lower median stays; the claim goes.
//
// ⚠️ THE MEDIAN TERM IS A BUG FIX, NOT A REFINEMENT, and the bug shipped. The
// first build bounded the vertex by `gain x mean(neighbours)` with the vertex
// ITSELF EXCLUDED, and asserted -- in this comment, in the commit message and in
// the design doc -- that uniform curvature was therefore a fixed point. That is
// only true for `gain >= 1`: below it, `gain x phi < phi` at every vertex of a
// correctly fitted arc, so the solver was asked to flatten geometry that was
// already right, burned its whole 200-sweep budget and stalled. Even at exactly
// 1 it bound at the ENDS of a curved run, where the +/-3 window pulls in the
// straight neighbours and drags the mean below the vertex's own turn.
//
// MEASURED on `2fe1725`, sweeping the shipped {0 8} range through the committed
// suite: gain 0 -> 16 failing, 0.5 -> 25, 1 -> 25, 2 -> 17, 4 -> 17, 8 -> 17.
// The two extra failures at 0.5 are `centreline_curvature_within_class` on
// C_radial (spike 1.100) and on F_bend (spike 1.688 -- the case that exists to
// run this mechanism at its design amplitude, worst hit of all); the other six
// are `turn_clamp_control_rig`, whose bend90 arc was flattened from R = 26.8 m
// to 57.8 m and whose bend135 stopped converging at all.
//
// The escape that hid it: `ring_legal` came back bit-identical at every gain and
// was read as proof of the fixed point. It is not. It clears the bound through
// the FLOOR, not through the fixed point -- at kappa x R_min = 0.223 the floor
// 0.25 x cls already exceeds its own turn. The self-excluded mean binds on a
// uniform arc exactly when `gain < 1` AND `kappa x R_min > PFSG_SMOOTH_FLOOR`,
// and no ring in the rig was above the floor. The rig now sweeps the gain.
//
// ⚠️ THIS IS NOT SURGICAL AND CANNOT BE MADE SO. It was tuned looking for a
// setting that touches C's ring seam and leaves A, B and D bit-identical, and
// MEASURED, no such setting exists: the seam is not geometrically distinct from
// a legitimate drawn corner. At the clamp's input C's seam is phi = 18.1 deg at
// 25.4x its neighbourhood; A's hand-drawn arterial corner at (-59.6, 9.9) is
// 11.0 deg at 53.9x. The drawn corner has the HIGHER contrast. Both come out of
// the class clamp at 0.85-0.89 of R_min, i.e. at the same place; what makes one
// read as a defect is that it sits inside a 100 m radius ring and the other
// does not, and no local measure sees that.
//
// So the choice is how much smoothing, not where. Measured over the whole suite:
//   floor 0.50 -- seam 13.4 -> ~11.9 deg, still visible; suite 17 -> 19 failing
//                 (a flipped face in C, two bowtie lots in B)
//   floor 0.25 -- seam 13.4 -> 7.3 deg, kink gone in the render; suite 17 -> 18
//                 (three bowtie lots in B, and B alone)
// 0.25 both fixes the defect and costs less, so 0.25 it is. The one new failure
// is `lots_are_simple_polygons` on B: self-touching parcels are a pre-existing
// S8 defect that C has failed with 49-57 parcels throughout, exposed in B
// because the centreline moved. It is an S8 bug, not this one.
#define PFSG_SMOOTH_W 3
#define PFSG_SMOOTH_FLOOR 0.25

// Lower median of a small unsorted array. Lower rather than mid-point so an
// even-sized window (the truncated one at a prim end) errs toward the tighter
// ceiling, i.e. toward smoothing, never toward letting a spike through.
// ⚠️ THAT IS ALSO WHY A TIGHTENING SPIRAL BINDS at its trailing end below
// gain 1 -- index (m-1)/2 of a truncated window whose every other member is
// smaller lands two positions below this vertex's own turn. The two are the
// same sentence read from opposite ends; see pfsg_turn_ceilings' header for the
// measurement and for why this side of the trade was kept.
float pfsg_median_lower(const float v[]) {
    int m = len(v);
    if (m < 1) return 0.0;
    float s[] = sort(v);
    return s[(m - 1) / 2];
}


void pfsg_turn_ceilings(const vector P[]; const float rmin, gain;
                        const int closed; export float phimax[]) {
    int n = len(P);
    resize(phimax, n);
    float phi[], cls[];
    resize(phi, n);
    resize(cls, n);
    for (int i = 0; i < n; i++) {
        phi[i] = 0.0;
        cls[i] = -1.0;               // -1 = this vertex has no turn to bound
        phimax[i] = -1.0;
    }
    int lo = closed ? 0 : 1, hi = closed ? n : n - 1;
    for (int i = lo; i < hi; i++) {
        float l1, l2;
        float t = abs(pfsg_turn_at(P[(i - 1 + n) % n], P[i], P[(i + 1) % n], l1, l2));
        if (l1 < 1e-9 || l2 < 1e-9) continue;
        phi[i] = t;
        cls[i] = 0.5 * (l1 + l2) / rmin;
    }
    for (int i = lo; i < hi; i++) {
        if (cls[i] < 0.0) continue;
        if (gain <= 0.0) { phimax[i] = cls[i]; continue; }
        float s = 0.0, w[];
        int c = 0;
        resize(w, 0);
        append(w, phi[i]);          // the level includes the vertex itself
        for (int j = -PFSG_SMOOTH_W; j <= PFSG_SMOOTH_W; j++) {
            if (j == 0) continue;
            int q = i + j;
            if (closed) q = (q % n + n) % n;
            else if (q < 1 || q > n - 2) continue;
            s += phi[q];
            c += 1;
            append(w, phi[q]);
        }
        float noise = (c > 0) ? gain * s / float(c) : cls[i];
        // The neighbourhood LEVEL. On any window where this vertex is not in
        // the strict upper half -- anywhere inside a run of PFSG_SMOOTH_W + 1
        // or more equally turning vertices, a uniform arc and the ends of such a
        // run included -- the lower median IS this vertex's own turn, so the
        // ceiling cannot fall below it and the bound cannot bind. A spike is a
        // minority of one in a window of seven, so the median is blind to it and
        // the `gain x mean` term still governs there.
        // ⚠️ This does NOT extend to a TRUNCATED window at a prim end, where
        // every other member can be smaller than this vertex's own turn: a
        // monotonically tightening spiral binds at its last three interior
        // vertices at gain <= 1. Measured; see the header.
        float level = pfsg_median_lower(w);
        phimax[i] = min(cls[i], max(max(noise, level), PFSG_SMOOTH_FLOOR * cls[i]));
    }
}


// Worst turn / its own ceiling. With `gain <= 0` the ceilings are the class
// clamp and this returns exactly `pfsg_turn_residual`.
float pfsg_turn_ratio(const vector P[]; const float phimax[]; const int closed) {
    int n = len(P);
    if (n < 3) return 0.0;
    float worst = 0.0;
    int lo = closed ? 0 : 1, hi = closed ? n : n - 1;
    for (int i = lo; i < hi; i++) {
        float l1, l2;
        float phi = abs(pfsg_turn_at(P[(i - 1 + n) % n], P[i], P[(i + 1) % n], l1, l2));
        if (l1 < 1e-9 || l2 < 1e-9 || phimax[i] <= 1e-9) continue;
        float r = phi / phimax[i];
        if (r > worst) worst = r;
    }
    return worst;
}


float pfsg_poly_length(const vector P[]; const int closed) {
    int n = len(P);
    float L = 0.0;
    for (int i = 1; i < n; i++) L += distance(P[i - 1], P[i]);
    if (closed && n > 1) L += distance(P[n - 1], P[0]);
    return L;
}


// Position at arc length `s` along a point array whose cumulative lengths are
// `acc`. The array form of pfsg_pos_at_length - the solver works on a local
// copy, not on geometry, because a wrangle reads INPUT points and would
// otherwise never see its own corrections.
vector pfsg_poly_sample(const vector P[]; const float acc[]; const float s) {
    int m = len(acc), n = len(P);
    if (m < 2) return P[0];
    float t = clamp(s, 0.0, acc[m - 1]);
    int j = 1;
    while (j < m - 1 && acc[j] < t) j++;
    float d = acc[j] - acc[j - 1];
    float u = (d <= 1e-12) ? 0.0 : (t - acc[j - 1]) / d;
    return lerp(P[(j - 1) % n], P[j % n], u);
}


// Resample `src` onto exactly `n` points, uniform by arc length, ends pinned.
vector[] pfsg_poly_resample(const vector src[]; const int n) {
    int m = len(src);
    if (m < 2 || n < 2) return src;
    float acc[];
    resize(acc, m);
    acc[0] = 0.0;
    for (int i = 1; i < m; i++) acc[i] = acc[i - 1] + distance(src[i - 1], src[i]);
    float L = acc[m - 1];
    vector out[];
    resize(out, n);
    out[0] = src[0];
    out[n - 1] = src[m - 1];
    for (int k = 1; k < n - 1; k++)
        out[k] = pfsg_poly_sample(src, acc, L * float(k) / float(n - 1));
    return out;
}


// Re-parametrise in place to uniform spacing, keeping the point count. This is
// the collapse guard: after it every segment is exactly L/(n-1), so bounding
// the total length bounds every segment at once.
void pfsg_turn_reparam(export vector P[]; const int closed) {
    int n = len(P);
    if (n < 3) return;
    if (!closed) {
        P = pfsg_poly_resample(P, n);
        return;
    }
    vector src[] = P;
    append(src, P[0]);
    vector r[] = pfsg_poly_resample(src, n + 1);
    resize(r, n);
    P = r;
}


// SEED. Replace every over-curved run with the circular arc of radius `rmin`
// tangent to the polyline on both sides - which is what S3b specifies in the
// first place - then resample back onto the original point count. Exact in one
// pass for an isolated corner, which is the case that matters: it is what turns
// an O(k^2) diffusion into a couple of dozen sweeps of cleanup.
//
// Returns 0 when some corner could not reach `rmin` because there is not enough
// straight either side of it. The caller does not treat that as failure - the
// partial arc is still a better starting point than the corner - it just means
// the relaxation has real work left and may not converge.
int pfsg_turn_fillet_seed(export vector P[]; const float rmin) {
    int n = len(P);
    if (n < 4 || rmin <= 1e-6) return 0;
    float acc[];
    resize(acc, n);
    acc[0] = 0.0;
    for (int i = 1; i < n; i++) acc[i] = acc[i - 1] + distance(P[i - 1], P[i]);
    float L = acc[n - 1];
    if (L <= 1e-9) return 0;

    int ra[], rb[];
    for (int i = 1; i < n - 1; ) {
        float l1, l2;
        float phi = abs(pfsg_turn_at(P[i - 1], P[i], P[i + 1], l1, l2));
        if (l1 < 1e-9 || l2 < 1e-9 || phi <= 0.5 * (l1 + l2) / rmin + 1e-9) {
            i++;
            continue;
        }
        int j = i;
        while (j + 1 < n - 1) {
            float m1, m2;
            float q = abs(pfsg_turn_at(P[j], P[j + 1], P[j + 2], m1, m2));
            if (m1 < 1e-9 || m2 < 1e-9 || q <= 0.5 * (m1 + m2) / rmin + 1e-9) break;
            j++;
        }
        append(ra, i);
        append(rb, j);
        i = j + 1;
    }
    int nr = len(ra);
    if (nr == 0) return 1;

    float step = L / float(n - 1);
    vector ideal[];
    append(ideal, P[0]);
    float cursor = -1.0, prev_end = 0.0;
    int exact = 1;
    for (int k = 0; k < nr; k++) {
        int a = ra[k], b = rb[k];
        vector d0 = P[a] - P[a - 1], d1 = P[b + 1] - P[b];
        float n0 = length(d0), n1 = length(d1);
        if (n0 < 1e-9 || n1 < 1e-9) { exact = 0; continue; }
        d0 /= n0;
        d1 /= n1;
        float phi = atan2(cross(d0, d1).y, dot(d0, d1));
        float ap = abs(phi);
        if (ap < 1e-6 || ap > 3.14159265 - 1e-3) { exact = 0; continue; }
        float tanh2 = abs(tan(phi * 0.5));

        // THE CORNER AND THE TWO LEGS. `T` is the tangent run measured back from
        // where the legs MEET, so both the legs and the corner have to be found
        // before it can be used. Two audits have gone through this construction
        // and each found the frame wrong in a different way:
        //
        //  * Measuring T from `acc[a-1]` / `acc[b+1]` — the vertices OUTSIDE the
        //    run — puts both tangent points a whole segment too far out, so the
        //    circle is tangent to neither leg. On the 90 degree bend that gave a
        //    clean 7.67 deg/vertex arc and then 28.85 / 19.66 / 20.92 deg back
        //    the other way, kappa x R_min 10.524 -> 3.748 instead of -> 1.
        //  * Taking each leg's direction from the ONE segment either side of the
        //    run is only right when the run is a single hard vertex. When the
        //    corner is drawn as an arc the run covers that arc, and those two
        //    segments are the arc's own first and last - tilted by a whole
        //    vertex-turn off the straight leg. Because the circle is built AT A
        //    it stays tangent there whatever d0 is, so the entry side can never
        //    show the error and all of it lands at B: measured over 8105 runs,
        //    median 0.15 m out at B, p99 18.9 m, worst 89.8 m. A legal 135
        //    degree arterial corner drawn at an 18 m radius did not converge.
        //
        // So the legs are re-read from the CHORD of the polyline just outside
        // where each tangent point lands, and the whole frame is re-solved from
        // them. The estimate and the tangent point converge in two rounds; a
        // third is cheap insurance.
        float nxt = (k + 1 < nr) ? acc[ra[k + 1] - 1] : L;
        float sV0 = 0.0, sV1 = 0.0, sA = 0.0, sB = L, T = 0.0, ru = rmin;
        int okrun = 1;
        for (int it = 0; it < 3; it++) {
            float den = d0.x * d1.z - d0.z * d1.x;      // = sin(phi), d unit
            if (abs(den) < 1e-9) { okrun = 0; break; }
            vector wv = P[b + 1] - P[a - 1];
            // arc position of the corner, reached along each leg in turn
            sV0 = acc[a - 1] + (wv.x * d1.z - wv.z * d1.x) / den;
            sV1 = acc[b + 1] + (wv.x * d0.z - wv.z * d0.x) / den;
            // the tangent run has to fit between this corner's neighbours: the
            // end of the previous fillet on one side, the start of the next run
            // on the other, and the polyline's own ends beyond those
            float avail = min(sV0 - prev_end, nxt - sV1);
            ru = rmin;
            T = rmin * tanh2;
            if (T > avail) { T = avail; ru = avail / max(tanh2, 1e-9); exact = 0; }
            if (ru <= 1e-6 || T <= 1e-9) { okrun = 0; break; }
            sA = max(sV0 - T, 0.0);
            sB = min(sV1 + T, L);
            if (it == 2) break;
            float w0 = min(T, sA - prev_end), w1 = min(T, nxt - sB);
            if (w0 > 1e-3) {
                vector e = pfsg_poly_sample(P, acc, sA)
                         - pfsg_poly_sample(P, acc, sA - w0);
                if (length(e) > 1e-9) d0 = normalize(e);
            }
            if (w1 > 1e-3) {
                vector e = pfsg_poly_sample(P, acc, sB + w1)
                         - pfsg_poly_sample(P, acc, sB);
                if (length(e) > 1e-9) d1 = normalize(e);
            }
            phi = atan2(cross(d0, d1).y, dot(d0, d1));
            ap = abs(phi);
            if (ap < 1e-6 || ap > 3.14159265 - 1e-3) { okrun = 0; break; }
            tanh2 = abs(tan(phi * 0.5));
        }
        if (!okrun) { exact = 0; continue; }

        // Build the corner, both tangent points and the centre from the ONE
        // frame, so the circle is tangent to both legs by construction.
        vector V = P[a - 1] + d0 * (sV0 - acc[a - 1]);
        vector A = V - d0 * T, B = V + d1 * T;
        // THE CENTRE IS ON THE BISECTOR. (d1 - d0) points from the corner
        // straight at it, and |VC| = ru / cos(phi/2). No candidates to test and
        // no way to pick the mirror - the test this replaces scored candidates
        // by their distance to B, which assumes B is already on the circle,
        // i.e. assumes the thing being constructed. An audit found it taking
        // the mirrored arc on 99 of 8105 runs.
        vector bis = d1 - d0;
        if (length(bis) < 1e-9) { exact = 0; continue; }
        vector C = V + normalize(bis) * (ru / max(cos(ap * 0.5), 1e-6));

        for (int q = 1; q < n; q++)
            if (acc[q] > cursor && acc[q] < sA) append(ideal, P[q]);
        append(ideal, A);
        float a0 = atan2(A.z - C.z, A.x - C.x);
        float a1 = atan2(B.z - C.z, B.x - C.x);
        float sweep = a1 - a0;
        while (sweep >  3.14159265) sweep -= 6.28318531;
        while (sweep < -3.14159265) sweep += 6.28318531;
        // OVERSAMPLE THE ARC, 4x finer than the spacing the prim will end up
        // with. The whole ideal curve is resampled onto n points afterwards, and
        // that resample chords whatever polygon it is given - so sampling the
        // arc at the final spacing concentrates the entire turn on the arc's own
        // vertices and the resample cannot see the circle at all. Measured at
        // 1x: a 135 degree bend settled at 1.0167 and never converged; at 4x it
        // reaches 1.0008 in a single pass. `step` is derived from the ORIGINAL
        // length, and the filleted curve is always shorter, so 1x is not even
        // parity.
        int steps = max(4, int(abs(sweep) * ru * 4.0 / max(step, 1e-6)));
        for (int q = 1; q < steps; q++) {
            float t = float(q) / float(steps), ang = a0 + sweep * t;
            append(ideal, set(C.x + ru * cos(ang), lerp(A.y, B.y, t),
                              C.z + ru * sin(ang)));
        }
        append(ideal, B);
        cursor = sB;
        prev_end = sB;
    }
    for (int q = 1; q < n - 1; q++)
        if (acc[q] > cursor) append(ideal, P[q]);
    append(ideal, P[n - 1]);
    if (len(ideal) < 2) return 0;
    P = pfsg_poly_resample(ideal, n);
    return exact;
}


// One Jacobi sweep. Each over-curved vertex is pulled toward the chord of its
// neighbours exactly as before - that part was right, and it is 4f-4's "smooth
// kappa" step - but the displacement is now SPREAD over the span the excess
// turn actually needs (its arc length is (phi - phimax) * rmin) instead of
// being applied to the one vertex. That single change is what removes the
// O(k^2): the corrected region no longer grows one vertex per sweep.
//
// The ceiling is now supplied per vertex by `pfsg_turn_ceilings` rather than
// derived from `rmin` here, so the same sweep serves the class clamp and the
// curvature-noise bound. The spread `m` is written in terms of the ceiling
// itself - the excess needs (phi - pm) x R_ceiling of arc and R_ceiling is
// meanseg / pm - which is ALGEBRAICALLY THE SAME EXPRESSION as before for the
// class ceiling, so this is bit-identical with the noise bound switched off.
int pfsg_turn_sweep(export vector P[]; const float phimax[]; const float relax;
                    const int closed) {
    int n = len(P);
    if (n < 3) return 0;
    vector D[];
    resize(D, n);
    int moved = 0;
    int lo = closed ? 0 : 1, hi = closed ? n : n - 1;
    for (int i = lo; i < hi; i++) {
        vector a = P[(i - 1 + n) % n], b = P[i], c = P[(i + 1) % n];
        float l1, l2;
        float phi = abs(pfsg_turn_at(a, b, c, l1, l2));
        if (l1 < 1e-9 || l2 < 1e-9) continue;
        float pm = phimax[i];
        if (pm <= 1e-9) continue;
        if (phi < 1e-6 || phi <= pm) continue;
        vector ac = c - a;
        float L2 = dot(ac, ac);
        if (L2 < 1e-12) continue;
        vector foot = a + ac * (dot(b - a, ac) / L2);
        vector dx = (foot + (b - foot) * (pm / phi) - b) * relax;
        int m = int((phi - pm) / pm);
        if (m < 1) m = 1;
        for (int j = -m; j <= m; j++) {
            int q = i + j;
            if (closed) q = (q % n + n) % n;
            else if (q < 1 || q > n - 2) continue;
            D[q] += dx * (1.0 - float(abs(j)) / float(m + 1));
        }
        moved = 1;
    }
    if (!moved) return 0;
    for (int i = 0; i < n; i++) P[i] += D[i];
    return 1;
}


// The solve. Iterates to a RESIDUAL with a budget, not to a fixed count, keeps
// the best iterate so a diverging sequence cannot ship its worst state, refuses
// any step that would take a segment below `minseg`, and reports whether it got
// there. Returns 1 when converged; `resid` and `sweeps` come back either way.
//
// TWO RESIDUALS, and they are not interchangeable. `resid` is the CLASS metric
// - the same expression `centreline_curvature_within_class` measures - and it
// alone decides `turn_clamp_converged`, because a solver that reports against a
// metric the check does not measure is a solver nobody can audit. `smooth` is
// the combined metric including 4f-4's curvature-noise bound, and it is what
// the iteration drives down. An iterate is only ever ACCEPTED when its class
// residual is no worse than where we started, so switching the noise bound on
// cannot make the class clamp worse - which is the failure mode the fold-back
// rig exists to catch.
int pfsg_turn_clamp_solve(export vector P[]; const float rmin, tol, minseg, gain;
                          const int closed, budget;
                          export float resid; export int sweeps;
                          export float smooth) {
    int n = len(P);
    sweeps = 0;
    float phimax[];
    pfsg_turn_ceilings(P, rmin, gain, closed, phimax);
    resid = pfsg_turn_residual(P, rmin, closed);
    smooth = max(resid, pfsg_turn_ratio(P, phimax, closed));
    if (n < 4 || smooth <= tol) return resid <= tol;

    vector best[] = P;
    float bestclass = resid, bestscore = smooth, startclass = resid;
    float accept = max(tol, startclass);
    int nseg = closed ? n : n - 1, stall = 0;

    if (!closed) {                      // the arc construction pins two ends
        vector S[] = P;
        pfsg_turn_fillet_seed(S, rmin);
        sweeps = 1;
        if (pfsg_poly_length(S, closed) >= minseg * float(nseg)) {
            pfsg_turn_ceilings(S, rmin, gain, closed, phimax);
            float rc = pfsg_turn_residual(S, rmin, closed);
            float rs = max(rc, pfsg_turn_ratio(S, phimax, closed));
            P = S;
            if (rs < bestscore && rc <= accept) {
                bestscore = rs; bestclass = rc; best = S;
            }
        }
    }
    while (sweeps < budget && bestscore > tol) {
        pfsg_turn_ceilings(P, rmin, gain, closed, phimax);
        if (!pfsg_turn_sweep(P, phimax, 0.5, closed)) break;
        sweeps += 1;
        // Backstop only. The re-parametrisation below is what actually bounds
        // the segments - it makes every one of them L/(n-1) - and an audit
        // confirmed this test has never fired on any case or either control
        // rig. It stays because it is the one place a shrinking polyline can
        // be caught before it ships, not because it is doing the work.
        if (pfsg_poly_length(P, closed) < minseg * float(nseg)) break;
        pfsg_turn_reparam(P, closed);
        pfsg_turn_ceilings(P, rmin, gain, closed, phimax);
        float rc = pfsg_turn_residual(P, rmin, closed);
        float rs = max(rc, pfsg_turn_ratio(P, phimax, closed));
        if (rs < bestscore - 1e-6 && rc <= accept) {
            bestscore = rs; bestclass = rc; best = P; stall = 0;
        }
        else if (++stall >= 50) break;  // not converging; stop burning cook time
    }
    P = best;
    resid = bestclass;
    smooth = bestscore;
    return bestclass <= tol;
}


// Average of a primitive's points.  Exact for a rectangle, and inside the
// loop for any convex block; an L-shaped block could in principle place it
// outside, which would misclassify that block. Acceptable for v1.
vector pfsg_prim_centre(const int geo, prim) {
    int pts[] = primpoints(geo, prim);
    vector c = {0, 0, 0};
    foreach (int pt; pts)
        c += vector(point(geo, "P", pt));
    return c / max(1, len(pts));
}


// Ray-crossing point-in-polygon test in the XZ plane.
int pfsg_point_in_loop_xz(const int geo, prim; const vector p) {
    int pts[] = primpoints(geo, prim);
    int n = len(pts), inside = 0;
    for (int i = 0, j = n - 1; i < n; j = i++) {
        vector a = point(geo, "P", pts[i]);
        vector b = point(geo, "P", pts[j]);
        if (((a.z > p.z) != (b.z > p.z)) &&
            (p.x < (b.x - a.x) * (p.z - a.z) / (b.z - a.z) + a.x))
            inside = !inside;
    }
    return inside;
}


// Signed area in the XZ plane (shoelace).  Magnitude is the area; the sign is
// winding, which polyexpand2d does NOT vary between outer and inner loops -
// so containment, not winding, is what separates a block from a boundary.
float pfsg_signed_area_xz(const int geo, prim) {
    int pts[] = primpoints(geo, prim);
    int n = len(pts);
    float s = 0;
    for (int i = 0; i < n; i++) {
        vector a = point(geo, "P", pts[i]);
        vector b = point(geo, "P", pts[(i + 1) % n]);
        s += a.x * b.z - b.x * a.z;
    }
    return 0.5 * s;
}


// Signed angle in degrees between two directions in the XZ plane.
float pfsg_angle_xz(const vector a, b) {
    vector2 u = set(a.x, a.z), v = set(b.x, b.z);
    return degrees(atan2(u.x * v.y - u.y * v.x, u.x * v.x + u.y * v.y));
}

#endif
