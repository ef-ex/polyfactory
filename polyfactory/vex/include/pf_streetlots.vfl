#ifndef __pf_streetlots_vfl__
#define __pf_streetlots_vfl__

// CityGen - S8 lot subdivision.
// Design: ideas/citygen_streets.md S8.
//
// NOT VORONOI. The shipped build subdivided with voronoifracture, and nothing
// in the surveyed literature does it that way. Parish & Mueller 2001 section
// 4.1: "most of these allotments are convex and rectangularly shaped ... a
// recursive algorithm that divides the longest edges that are approximately
// parallel", discarding lots that are too small or have no street access.
// Every other implementation we looked at also subdivides rectangularly and
// recursively. Voronoi is why the lots read as wrong.
//
// Two modes ship in v1:
//   recursive_obb - min-area oriented bounding box, split across the long axis,
//                   recurse. Rectangular, street-facing, back-to-back lots.
//   offset        - inward offset makes a street-facing ring plus a courtyard
//                   remainder; the ring is cut orthogonally to the contour.
//                   This is the EUROPEAN PERIMETER BLOCK and it is a different
//                   algorithm, not a variation of the first.

#define PFSL_EPS 1e-6

// Signed area in XZ, read as (x, z). Positive = CCW in that convention.
float pfsl_signed_area(const vector p[]) {
    float a = 0;
    int n = len(p);
    for (int i = 0; i < n; i++) {
        vector q0 = p[i], q1 = p[(i + 1) % n];
        a += q0.x * q1.z - q1.x * q0.z;
    }
    return a * 0.5;
}

float pfsl_area(const vector p[]) { return abs(pfsl_signed_area(p)); }


// Ray-crossing point-in-polygon in XZ, on a point ARRAY.  The array form is
// needed because the clipper below works on candidate pieces that are not
// geometry yet - pfsg_point_in_loop_xz reads a primitive and cannot see them.
int pfsl_point_in_poly_xz(const vector p[]; const vector q) {
    int n = len(p), inside = 0;
    for (int i = 0, j = n - 1; i < n; j = i++) {
        vector a = p[i], b = p[j];
        if (((a.z > q.z) != (b.z > q.z)) &&
            (q.x < (b.x - a.x) * (q.z - a.z) / (b.z - a.z) + a.x))
            inside = !inside;
    }
    return inside;
}


// Half-plane clip: keep the side the normal points AWAY from, i.e.
// dot(q - p0, nrm) <= 0.  Returns EVERY connected piece - `out` is the pieces'
// vertices end to end and `cnt` is how many belong to each.
//
// !! IT REPLACES A SUTHERLAND-HODGMAN CLIP, WHICH IS NOT SAFE ON A CONCAVE
// SUBJECT. S-H returns ONE ring joining the disjoint pieces with a ZERO-WIDTH
// BRIDGE: two coincident edges traversed in opposite directions along the clip
// line. Control case, a U-shaped block (the shape of every block that wraps a
// dead-end stub, where the notch IS the stub's road) split across the notch
// mouth - it is the worst case because two of its vertices lie exactly ON the
// clip line, so there are no crossings there to pair:
//
//   U    = (0,0)(100,0)(100,60)(60,60)(60,20)(40,20)(40,60)(0,60)
//   clip = keep z >= 20
//   S-H  = (100,20)(100,60)(60,60)(60,20)(40,20)(40,60)(0,60)(0,20)   ONE ring
//   here = (100,20)(100,60)(60,60)(60,20) + (40,20)(40,60)(0,60)(0,20)  TWO
//
// The two prongs were always right and pfsl_area always returned exactly
// 3200 = their true area, because the bridge encloses nothing. But the S-H
// ring's boundary crossed the notch TWICE - once on (60,20)->(40,20) and once
// on the closing (0,20)->(100,20) - so the parcel that shipped had two edges
// lying down the middle of the stub's pavement while every area measurement in
// the project read zero. Measured on C_radial before this: 39 lots, 1290 m of
// boundary inside the road surface, `lots_clear_of_roads` m2 = 0.0 at cell
// sizes down to 0.01 m. `lots_clear_of_roads.edge_m` and
// `lots_are_simple_polygons` are what see it, and `lot_clip_control_rig` runs
// exactly the case above so the fix cannot rot.
//
// CONSTRUCTION, and it is a boolean rather than a walk. The kept region's
// boundary is (i) the polygon boundary that survives, cut at the crossings,
// plus (ii) the stretches of the CLIP LINE that the kept region actually
// borders. Pairing crossings in sorted order gets (ii) right only while no
// vertex lies on the line; the U has two that do, and there the notch mouth is
// a boundary edge with the region on its FAR side. So (ii) is decided by
// testing, on each span between consecutive boundary hits, whether the polygon
// interior is immediately on the keep side. Then the directed edges are
// chained by their endpoints, and each closed chain is one piece.
//
// Directed so the kept side is on the same hand as the input's own interior,
// which makes the pieces come back wound the way the block went in. For a
// CONVEX subject the first chain starts on the same vertex S-H started on and
// visits the same points in the same order, so this is a drop-in.
// On-the-line, the endpoint weld, and the shortest edge worth emitting - all
// one number, and it is 1 mm because that is what `lots_are_simple_polygons`
// already calls "the same point". At 1e-4 the clipper emitted a 0.497 mm edge
// in C_radial that the check then reported as a self-touching parcel: a clipper
// whose idea of degenerate is finer than the checker's manufactures failures.
#define PFSL_CLIP_EPS 1e-3
void pfsl_clip_multi(const vector p[]; const vector p0, nrm;
                     export vector out[]; export int cnt[]) {
    resize(out, 0);
    resize(cnt, 0);
    int n = len(p);
    if (n < 3) return;
    vector nl = set(nrm.x, 0, nrm.z);
    float nlen = length(nl);
    if (nlen < 1e-12) return;
    nl /= nlen;
    // +tg keeps the KEPT side to the LEFT; a clockwise subject wants it right
    vector tg = set(-nl.z, 0, nl.x) * ((pfsl_signed_area(p) < 0) ? -1.0 : 1.0);
    float eps = PFSL_CLIP_EPS;

    float d[];
    resize(d, n);
    for (int i = 0; i < n; i++) d[i] = dot(p[i] - p0, nl);

    // (i) the surviving boundary, and every place the boundary meets the line
    vector ea[], eb[];
    float tcrit[];
    for (int i = 0; i < n; i++) {
        int i2 = (i + 1) % n;
        float da = d[i], db = d[i2];
        vector a0 = p[i], b0 = p[i2], a = a0, b = b0;
        int oa = (da > eps), ob = (db > eps);
        int za = (abs(da) <= eps), zb = (abs(db) <= eps);
        if (za && zb) {           // the edge LIES on the line: (ii) re-derives it
            append(tcrit, dot(a0 - p0, tg));
            append(tcrit, dot(b0 - p0, tg));
            continue;
        }
        if (oa && ob) continue;                        // wholly on the far side
        float t = da / (da - db);
        if (oa)      { a = a0 + (b0 - a0) * t; append(tcrit, dot(a - p0, tg)); }
        else if (za) { append(tcrit, dot(a0 - p0, tg)); }
        if (ob)      { b = a0 + (b0 - a0) * t; append(tcrit, dot(b - p0, tg)); }
        else if (zb) { append(tcrit, dot(b0 - p0, tg)); }
        if (distance(a, b) > eps) { append(ea, a); append(eb, b); }
    }

    // (ii) the stretches of the clip line the kept region borders
    int m = len(tcrit);
    if (m > 1) {
        float ts[] = sort(tcrit);
        for (int i = 1; i < m; i++) {
            float t0 = ts[i - 1], t1 = ts[i];
            if (t1 - t0 <= eps) continue;
            // probe just inside the keep side. Anything thinner than this is
            // orders of magnitude below min_lot_area and is not a parcel.
            float probe = clamp((t1 - t0) * 0.01, 1e-4, 1e-3);
            vector mid = p0 + tg * ((t0 + t1) * 0.5) - nl * probe;
            if (!pfsl_point_in_poly_xz(p, mid)) continue;
            append(ea, p0 + tg * t0);
            append(eb, p0 + tg * t1);
        }
    }

    // chain the directed edges: each closed chain is one piece
    int ne = len(ea);
    if (ne < 3) return;
    int used[];
    resize(used, ne);
    for (int i = 0; i < ne; i++) used[i] = 0;
    for (int s = 0; s < ne; s++) {
        if (used[s]) continue;
        vector ring[];
        vector start = ea[s];
        int cur = s, guard = 0;
        while (cur >= 0 && guard <= ne) {
            guard++;
            used[cur] = 1;
            append(ring, ea[cur]);
            vector tail = eb[cur];
            if (distance(tail, start) <= eps) break;
            int nxt = -1;
            float bestd = eps;
            for (int k = 0; k < ne; k++) {
                if (used[k]) continue;
                float dd = distance(ea[k], tail);
                if (dd <= bestd) { bestd = dd; nxt = k; }
            }
            if (nxt < 0) { append(ring, tail); break; }   // open: keep the area
            cur = nxt;
        }
        if (len(ring) < 3) continue;
        if (pfsl_area(ring) < PFSL_EPS) continue;
        append(cnt, len(ring));
        foreach (vector v; ring) append(out, v);
    }
}


// Minimum-area oriented bounding box by rotating calipers over the edge
// directions - the minimum-area rectangle always has a side flush with an edge.
// Returns the long axis and both extents.
void pfsl_obb(const vector p[]; export vector axis; export float lenlong, lenshort;
              export vector centre) {
    vector up = {0, 1, 0};
    int n = len(p);
    float best = 1e30;
    axis = {1, 0, 0}; lenlong = 0; lenshort = 0; centre = {0, 0, 0};
    for (int i = 0; i < n; i++) {
        vector e = p[(i + 1) % n] - p[i];
        e.y = 0;
        if (length(e) < PFSL_EPS) continue;
        vector u = normalize(e);
        vector v = normalize(cross(u, up));
        float u0 = 1e30, u1 = -1e30, v0 = 1e30, v1 = -1e30;
        for (int k = 0; k < n; k++) {
            float du = dot(p[k], u), dv = dot(p[k], v);
            u0 = min(u0, du); u1 = max(u1, du);
            v0 = min(v0, dv); v1 = max(v1, dv);
        }
        float a = (u1 - u0) * (v1 - v0);
        if (a < best) {
            best = a;
            vector mid = u * ((u0 + u1) * 0.5) + v * ((v0 + v1) * 0.5);
            centre = set(mid.x, 0, mid.z);
            if ((u1 - u0) >= (v1 - v0)) { axis = u; lenlong = u1 - u0; lenshort = v1 - v0; }
            else                        { axis = v; lenlong = v1 - v0; lenshort = u1 - u0; }
        }
    }
}


float pfsl_seg_dist(const vector a, b, q) {
    vector ab = b - a;
    float L2 = dot(ab, ab);
    if (L2 < PFSL_EPS) return distance(a, q);
    float t = clamp(dot(q - a, ab) / L2, 0.0, 1.0);
    return distance(a + ab * t, q);
}

// Total length of lot edges lying on the block boundary - i.e. STREET FRONTAGE.
//
// Measure against the boundary LINES, never against a filled polygon: xyzdist
// into a polygon returns ~0 everywhere inside it, so every lot passes,
// including the unbuildable ones. That bug shipped once already.
float pfsl_frontage(const vector block[], lot[]; const float tol) {
    float total = 0;
    int nb = len(block), nl = len(lot);
    for (int i = 0; i < nl; i++) {
        vector a = lot[i], b = lot[(i + 1) % nl];
        vector mid = (a + b) * 0.5;
        float d = 1e30;
        for (int k = 0; k < nb; k++)
            d = min(d, pfsl_seg_dist(block[k], block[(k + 1) % nb], mid));
        if (d <= tol) total += distance(a, b);
    }
    return total;
}


// Smallest street frontage among the pieces one side of a cut produced.
// `pfsl_clip_multi` returns several pieces, and "this side of the cut still
// reaches a street" is only true when EVERY piece of it does - the whole point
// of the concave fix is that half a cut can be two disjoint parcels, and one of
// them can be landlocked while the other fronts the street.
float pfsl_min_frontage(const vector block[], pts[]; const int cnt[];
                        const float tol) {
    int np = len(cnt);
    if (np < 1) return 0.0;
    float worst = 1e30;
    int off = 0;
    for (int i = 0; i < np; i++) {
        vector piece[];
        for (int k = 0; k < cnt[i]; k++) append(piece, pts[off + k]);
        off += cnt[i];
        worst = min(worst, pfsl_frontage(block, piece, tol));
    }
    return worst;
}


// Longest CONTIGUOUS run of lot boundary lying on the block boundary.
//
// NOT pfsl_frontage, which SUMS every qualifying edge. A wedge parcel with
// three separate 2 m nibbles of street sums to 6 m and clears a 6 m minimum
// while having no single edge a building can sit against - the classic radial
// failure, pinched at the inner ring. A building needs one unbroken street
// edge, which is what S8 asks for as "minimum width at the frontage" and what
// no summed measure can see.
//
// Also not the oriented box's short side: that is the narrowest dimension in
// ANY orientation, so a trapezoid 3 m at the street and 20 m at the back passes
// it. The three measures answer three different questions and none implies
// another.
float pfsl_street_edge(const vector block[], lot[]; const float tol) {
    int nb = len(block), nl = len(lot);
    if (nl < 2 || nb < 2) return 0.0;

    int onb[];
    float seg[];
    resize(onb, nl);
    resize(seg, nl);
    float total = 0;
    for (int i = 0; i < nl; i++) {
        vector a = lot[i], b = lot[(i + 1) % nl];
        vector mid = (a + b) * 0.5;
        float d = 1e30;
        for (int k = 0; k < nb; k++)
            d = min(d, pfsl_seg_dist(block[k], block[(k + 1) % nb], mid));
        onb[i] = (d <= tol);
        seg[i] = distance(a, b);
        if (onb[i]) total += seg[i];
    }

    // Two laps of the ring, so a run straddling the start vertex is measured
    // whole instead of being cut in half by where the array happens to begin.
    float best = 0, run = 0;
    for (int lap = 0; lap < 2; lap++) {
        for (int i = 0; i < nl; i++) {
            if (onb[i]) { run += seg[i]; best = max(best, run); }
            else        { run = 0; }
        }
    }
    // ...and the guard the second lap needs: a parcel entirely on the boundary
    // never resets, so it would report twice its own perimeter.
    return min(best, total);
}


// Signed orientation of (a, b, c) in XZ. > 0 means c is left of a->b.
float pfsl_orient(const vector a, b, c) {
    return (b.x - a.x) * (c.z - a.z) - (b.z - a.z) * (c.x - a.x);
}


// Do two segments PROPERLY cross in XZ - strictly, interior to both? Touching
// at an endpoint or lying collinear is not a crossing.
int pfsl_seg_cross(const vector a, b, c, d) {
    float o1 = pfsl_orient(a, b, c), o2 = pfsl_orient(a, b, d);
    float o3 = pfsl_orient(c, d, a), o4 = pfsl_orient(c, d, b);
    return (o1 * o2 < 0.0) && (o3 * o4 < 0.0);
}


// Is a closed ring simple - does no edge cross any non-adjacent edge?
//
// ⚠️ This is an EDGE-EDGE test, and that is the whole point. The suite's
// `lots_are_simple_polygons` asks whether any VERTEX lies on a non-adjacent
// edge, and its docstring claimed that "covers the pinch and a true crossing
// alike". It does not: two edges crossing X-wise with no vertex near the other
// edge are invisible to a vertex-to-edge distance test. On the six folded
// parcels this function was written for, the nearest vertex-to-edge distance
// ranges from 0.029 m to 1.14 m against a 1e-3 m tolerance - three orders out.
int pfsl_ring_is_simple(const vector p[]) {
    int n = len(p);
    if (n < 4) return 1;
    for (int i = 0; i < n; i++) {
        for (int j = i + 2; j < n; j++) {
            if (i == 0 && j == n - 1) continue;      // adjacent across the seam
            if (pfsl_seg_cross(p[i], p[(i + 1) % n], p[j], p[(j + 1) % n]))
                return 0;
        }
    }
    return 1;
}


// Emit one lot polygon, dropping the slivers a clip leaves behind.
int pfsl_emit(const int geo; const vector p[]; const float minarea) {
    int n = len(p);
    if (n < 3) return -1;
    if (pfsl_area(p) < minarea) return -1;
    int prim = addprim(geo, "poly");
    for (int i = 0; i < n; i++) {
        vector q = p[i];
        addvertex(geo, prim, addpoint(geo, set(q.x, 0, q.z)));
    }
    return prim;
}

#endif
