#ifndef __pf_streetjunction_vfl__
#define __pf_streetjunction_vfl__

// CityGen - S5 intersection geometry.
// Design: ideas/citygen_streets.md section S5.
//
// BASED ON HANNES' OWN SOLVER (attribwrangle62 / attribwrangle77 in
// cityGen.hip), which solves the exact point where the KERB LINES of two
// adjacent streets intersect, then fillets that corner with a circular arc.
// That is the correct construction and it predates any research here.
//
// Do NOT replace this with "trim every street back by a radius". A single
// scalar per node is wrong whenever incident widths or angles differ, which is
// nearly always; it gaps or overlaps by construction.
//
// Three refinements from sources (see resources/citygen/README.md):
//   * the corner formula IS a stroke MITER JOIN, so it spikes to infinity at
//     shallow angles. Cured with a miter limit + bevel fallback, exactly as in
//     SVG stroke rendering.
//   * trim each street per PAIR, to the fillet tangent point, not per node.
//   * corner radius comes from street class via design speed, not a constant.

#define PFSJ_EPS 1e-6


// Simplification of Hannes' derivation. With beta = angle and
// alpha = pi/2 - angle, both his sideA and sideB divide by sin(angle):
//     corner = centre + (dirA*(wB/2) + dirB*(wA/2)) / sin(angle)
// which is the intersection of the two offset kerb lines.
//
// `ok` returns 0 when the streets are collinear and no finite corner exists.
vector pfsj_corner(const vector centre, dirA, dirB;
                   const float wA, wB; export int ok) {
    float d = clamp(dot(dirA, dirB), -1.0, 1.0);
    float ang = acos(d);
    float s = sin(ang);
    if (s < 0.02) {                 // ~1.1 degrees: collinear, miter undefined
        ok = 0;
        return centre;
    }
    ok = 1;
    return centre + (dirA * (wB * 0.5) + dirB * (wA * 0.5)) / s;
}


// The same kerb-line intersection, but with each line given EXPLICITLY as a
// point and a direction instead of being derived from one shared node.
//
// Needed because the two kerb lines no longer pass through the node: each
// street's mouth is now placed on its own polyline at the cut, with that
// polyline's tangent, so a curved arm's kerb line is offset AND rotated
// relative to the node frame. Solving from `centre` there put the corner in a
// different frame from the cap it has to meet, which is the seam wedge.
//
// `dA`/`dB` point AWAY from the junction; `PA`/`PB` are points on the two kerb
// lines. `ok` returns 0 when they are parallel and no finite corner exists.
// The threshold matches pfsj_corner: |sin(angle)| < 0.02, about 1.1 degrees.
vector pfsj_corner_lines(const vector PA, dA, PB, dB; export int ok) {
    float den = dA.x * dB.z - dA.z * dB.x;
    if (abs(den) < 0.02) {
        ok = 0;
        return PA;
    }
    ok = 1;
    vector w = PB - PA;
    float u = (w.x * dB.z - w.z * dB.x) / den;
    return PA + dA * u;
}


// Miter length relative to the widest incident half-width. Above the limit the
// spike must be replaced by a bevel. SVG's default limit is 4.0, which bevels
// below roughly 29 degrees.
float pfsj_miter_ratio(const vector centre, corner; const float wA, wB) {
    float half = max(wA, wB) * 0.5;
    return half < PFSJ_EPS ? 1e9 : distance(centre, corner) / half;
}


// Fillet inscribed in the corner: centre sits r/sin(theta/2) from the corner
// along the inner bisector, tangents sit r/tan(theta/2) back along each kerb.
//
// The radius is CLAMPED, via `max_run`, to what the junction can actually
// hold. `max_run` is the longest tangent run the caller will allow - S5's
// `max_fillet_fraction` (0.4) of the shorter of the two incident streets.
// This clamp was specified in the design and never implemented (the line used
// to read `radius_used = radius;` under a comment claiming otherwise): cuts
// reached 26 m, three streets were consumed whole while their junction kept a
// mouth for them, and thirteen more lost over half their length.
// Pass max_run <= 0 to disable it. `radius_used` reports what was applied.
void pfsj_fillet(const vector corner, dirA, dirB; const float radius, max_run;
                 export vector arc_centre, tanA, tanB;
                 export float radius_used; export int ok) {
    float d = clamp(dot(dirA, dirB), -1.0, 1.0);
    float theta = acos(d);
    float half = theta * 0.5;
    if (sin(half) < 0.02 || tan(half) < PFSJ_EPS) {
        ok = 0; radius_used = 0.0;
        arc_centre = corner; tanA = corner; tanB = corner;
        return;
    }
    ok = 1;

    // The kerb fillet rounds the BLOCK corner, so it sits OUTSIDE the junction:
    // the tangent points run away from the node along each kerb, and the arc
    // centre is on the far side of the corner. Rounding inwards instead makes
    // the tangents fall short of the kerb intersection, so each street gets
    // trimmed LESS than the clearance it needs and the two drive straight
    // through each other. That was the visible failure.
    float tn = tan(half);
    float t = radius / tn;
    if (max_run > 0.0 && t > max_run) t = max_run;
    radius_used = t * tn;

    tanA = corner + dirA * t;
    tanB = corner + dirB * t;
    vector bis = normalize(dirA + dirB);
    if (length(dirA + dirB) < PFSJ_EPS) bis = dirA;
    arc_centre = corner + bis * (radius_used / sin(half));
}


// Turning radius derived from street class via design speed, rather than a
// fixed number. A default the artist overrides, never a constant.
float pfsj_corner_radius(const string street_class) {
    if (street_class == "highway")   return 25.0;
    if (street_class == "arterial")  return 9.0;
    if (street_class == "collector") return 6.0;
    if (street_class == "alley")     return 2.0;
    return 4.0;                                   // local
}


// Signed area of a closed XZ boundary, read as (x, z) in the usual 2D sense.
// Positive means the interior lies to the LEFT of the traversal direction, and
// cross(edge, up) is exactly that left normal.
float pfsj_signed_area(const vector pts[]) {
    float a = 0;
    int n = len(pts);
    for (int i = 0; i < n; i++) {
        vector p0 = pts[i], p1 = pts[(i + 1) % n];
        a += p0.x * p1.z - p1.x * p0.z;
    }
    return a;
}


// Inward miter offset of one vertex of a closed boundary.
//
// The junction surface has to carry the street cross-section through it -
// sidewalk band, kerb riser, carriageway - not be a flat plate. Offsetting the
// outer boundary inward by the local sidewalk width gives the kerb line, and
// because the offset at a cap corner equals that street's own sidewalk width,
// the kerb lines up with the road's kerb exactly (citygen_streets.md S5:
// "matching cross-section element boundaries ... sidewalk meets sidewalk").
//
// `orient` is +1 or -1 from pfsj_signed_area. An earlier version took an
// `inside` POINT and flipped each normal to face it, which is only valid on a
// convex boundary: once the corner fillets make the junction non-convex the
// centroid falls on the wrong side of an edge, one normal inverts, the bisector
// collapses and the miter clamp fires at its 4x limit - throwing the inner ring
// ~10m across the junction and folding the carriageway. Winding is orientation
// truth for any simple polygon, convex or not.
vector pfsj_inward_offset(const vector prev, cur, next; const float orient, dist) {
    vector up = {0, 1, 0};
    vector e1 = cur - prev, e2 = next - cur;
    e1.y = 0; e2.y = 0;
    if (length(e1) < PFSJ_EPS) e1 = e2;
    if (length(e2) < PFSJ_EPS) e2 = e1;
    if (length(e1) < PFSJ_EPS) return cur;
    e1 = normalize(e1); e2 = normalize(e2);

    vector n1 = normalize(cross(e1, up)) * orient;
    vector n2 = normalize(cross(e2, up)) * orient;

    vector bis = n1 + n2;
    if (length(bis) < PFSJ_EPS) return cur + n1 * dist;
    bis = normalize(bis);
    float c = max(dot(bis, n1), 0.5);             // <=2x; a real spike is a bug
    return cur + bis * (dist / c);
}


// Sample a point on the fillet arc. `t` runs 0..1 from tanA to tanB, taking
// the SHORT way round, which is the side the junction is on.
vector pfsj_arc_point(const vector arc_centre, tanA, tanB; const float t) {
    vector a = tanA - arc_centre;
    vector b = tanB - arc_centre;
    float r = length(a);
    if (r < PFSJ_EPS) return tanA;
    vector an = normalize(a), bn = normalize(b);
    float d = clamp(dot(an, bn), -1.0, 1.0);
    float sweep = acos(d);
    if (sweep < PFSJ_EPS) return tanA;
    vector axis = cross(an, bn);
    if (length(axis) < PFSJ_EPS) return tanA;
    axis = normalize(axis);
    matrix3 m = ident();
    rotate(m, sweep * t, axis);
    return arc_centre + (an * m) * r;
}


// ---------------------------------------------------------------------------
// DEPRECATED - backwards compatibility for networks built before 2026-08-10
// ---------------------------------------------------------------------------
//
// These are the pre-split signatures.  They exist so hand-built networks that
// nobody can grep - the artist's /obj/pf_citygen in cityGen.hip is one - keep
// compiling and keep their ORIGINAL behaviour.  Nothing shipped calls them;
// new code must use the versions above.
//
// Why this block exists at all: changing a shared signature under existing
// callers breaks scenes silently.  `pfsj_fillet` was the instructive case -
// old and new both take 10 arguments, so the old call site did NOT go red, it
// bound `dirB` (a vector) to `radius` (a float) through an implicit cast and
// produced quietly wrong junctions.  A red node is a bug report; this was not.

// Pre-2026-08-10 fillet: took the junction `centre` as its first argument (and
// ignored it), and had no `max_run` clamp - the radius was used as given.
// Restored verbatim so old callers get the geometry they had, not the clamped
// geometry the new solver produces.
void pfsj_fillet(const vector centre, corner, dirA, dirB; const float radius;
                 export vector arc_centre, tanA, tanB;
                 export float radius_used; export int ok) {
    float d = clamp(dot(dirA, dirB), -1.0, 1.0);
    float theta = acos(d);
    float half = theta * 0.5;
    if (sin(half) < 0.02 || tan(half) < PFSJ_EPS) {
        ok = 0; radius_used = 0.0;
        arc_centre = corner; tanA = corner; tanB = corner;
        return;
    }
    ok = 1;
    radius_used = radius;                      // no max_run clamp: old behaviour
    float t = radius_used / tan(half);

    tanA = corner + dirA * t;
    tanB = corner + dirB * t;
    vector bis = normalize(dirA + dirB);
    if (length(dirA + dirB) < PFSJ_EPS) bis = dirA;
    arc_centre = corner + bis * (radius_used / sin(half));
}

// Removed 2026-08-10 by "citygen S5: every junction corner is a real fillet",
// which replaced the bevel fallback with a true fillet.  Old callers still
// reference it, so it stays available to them unchanged.
void pfsj_bevel(const vector centre, dirA, dirB; const float wA, wB;
                export vector bA, bB) {
    vector up = {0, 1, 0};
    vector nA = normalize(cross(dirA, up));
    vector nB = normalize(cross(dirB, up));
    if (dot(nA, dirB) < 0) nA = -nA;      // face the neighbour
    if (dot(nB, dirA) < 0) nB = -nB;
    bA = centre + nA * (wA * 0.5);
    bB = centre + nB * (wB * 0.5);
}

// Removed by the same commit.  Note `r = max(radius, halfc)` - a smaller circle
// cannot reach both endpoints.  That line was later identified as the root
// cause of two visual failures, which is exactly why it must NOT be "fixed"
// here: this function's contract is to reproduce the old output.
vector pfsj_arc_centre_through(const vector p, q, inside; const float radius) {
    vector mid = (p + q) * 0.5;
    vector chord = q - p;
    float halfc = length(chord) * 0.5;
    if (halfc < PFSJ_EPS) return mid;
    float r = max(radius, halfc);
    float h = sqrt(max(r * r - halfc * halfc, 0.0));
    vector up = {0, 1, 0};
    vector perp = normalize(cross(normalize(chord), up));
    if (dot(perp, mid - inside) < 0) perp = -perp;   // bulge away from the node
    return mid + perp * h;
}

#endif
