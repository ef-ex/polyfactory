<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <!-- This file contains definitions of Python interfaces and the
 interfaces menu.  It should not be hand-edited when it is being
 used by the application.  Note, that two definitions of the
 same interface or of the interfaces menu are not allowed
 in a single file. -->
  <interface name="pf_kitbash_ui" label="Kitbash Assets" icon="SOP_file" showNetworkNavigationBar="true" help_url="">
    <script><![CDATA[########################################################################
# Kitbash HDA UI - Asset browser and placed assets manager
#
# This interface is automatically loaded for pf_kitbash nodes.
########################################################################

from PySide6 import QtWidgets
from polyfactory.asset_library.kitbash_ui import KitbashNodeUI

g_kitbash_ui = None

def onCreateInterface():
    """
    Entry point for pf_kitbash Python Panel UI.
    Returns the root widget with asset browser and placed assets list.
    Node is not available yet - will be set via onNodePathChanged.
    """
    global g_kitbash_ui
    
    # Create UI without node - it will be initialized when onNodePathChanged is called
    g_kitbash_ui = KitbashNodeUI()
    return g_kitbash_ui


def onActivateInterface():
    """Called when the interface pane becomes active."""
    global g_kitbash_ui
    g_kitbash_ui.refresh()

def onDeactivateInterface():
    """Called when the interface pane becomes inactive."""
    pass

def onDestroyInterface():
    """Called when the interface is destroyed."""
    global g_kitbash_ui
    g_kitbash_ui = None

def onNodePathChanged(node):
    """Called when the node path changes - this provides the actual node."""
    global g_kitbash_ui
    g_kitbash_ui.set_node(node)
]]></script>
    <showInParametersPane optype="pf::Sop/pf_kitbash*"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
