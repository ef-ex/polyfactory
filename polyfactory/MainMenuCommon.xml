<?xml version="1.0" encoding="UTF-8"?>
<mainMenu>
  <menuBar>
    <subMenu id="polyfactory_menu">
      <label>polyfactory</label>
      <scriptItem id="h.pf_modelui_toggle">
        <label>modelUI | Houdini</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import switch
switch.toggle_later()
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.pf_modelui_add_kitbash">
        <label>Add kitbash pieces...</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import kitbash
kitbash.add_dialog()
]]></scriptCode>
      </scriptItem>
      <separatorItem/>
      <scriptItem id="h.pf_modelui_align">
        <label>Align...</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import align
align.align()
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.pf_modelui_quick_align">
        <label>Quick Align</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import align
align.quick_align()
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.pf_modelui_normal_align">
        <label>Normal Align...</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import align
align.normal_align()
]]></scriptCode>
      </scriptItem>
      <separatorItem/>
      <scriptItem id="h.pf_modelui_copy">
        <label>Copy Selection</label>
        <scriptCode><![CDATA[
from polyfactory.modelui import clipboard
clipboard.copy()
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.pf_modelui_paste">
        <label>Paste</label>
        <scriptCode><![CDATA[
import hdefereval
from polyfactory.modelui import clipboard
hdefereval.executeDeferred(clipboard.paste)   # after the menu action: its own undo step, "modelUI: paste"
]]></scriptCode>
      </scriptItem>
      <scriptItem id="h.pf_modelui_paste_at">
        <label>Paste at Look-at Point</label>
        <scriptCode><![CDATA[
import hdefereval
from polyfactory.modelui import clipboard
hdefereval.executeDeferred(clipboard.paste_at_look_at)   # after the menu action: its own undo step, "modelUI: paste"
]]></scriptCode>
      </scriptItem>
    </subMenu>
  </menuBar>
</mainMenu>
