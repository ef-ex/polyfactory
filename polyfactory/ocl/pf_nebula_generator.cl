// pf_nebula_generator kernel body (the #bind header is generated by devScripts/create_pf_nebula_generator_hda.py
// from its PARMS table; pf_space_dir() is prepended from pf_space_common.PF_SPACE_DIR_CL).
// Port of Blender "Nebula Generator 3.0.3": a scattering volume (main dust + gas) lit by a sun lamp and a point
// lamp, seen from a viewer inside it, plus small/large stars and a voronoi star background. See ideas/spacetools.md.

#define PF_PI 3.14159265359f
#define PF_LIGHT_GAIN 4.0f   // calibrated: our light units -> Cycles sun/point strength (measured mean-luminance ratio 4.1, see doc)

// ---------------------------------------------------------------- hash / noise
inline uint pf_h(uint x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
inline uint pf_h3(int3 c, uint s) { return pf_h(pf_h(pf_h((uint)c.x + s * 0x9E3779B9U) + (uint)c.y) + (uint)c.z); }
inline float pf_u01(uint h) { return (float)(h >> 8) * (1.0f / 16777216.0f); }
inline float pf_gr(uint h, float x, float y, float z)
{
    h &= 15u;
    float u = h < 8u ? x : y;
    float v = h < 4u ? y : ((h == 12u || h == 14u) ? x : z);
    return ((h & 1u) ? -u : u) + ((h & 2u) ? -v : v);
}
// improved Perlin noise, signed, ~[-1,1] (Blender scales it by 0.982 too)
float pf_perlin(float3 p)
{
    float3 fl = floor(p);
    int3 i0 = convert_int3(fl);
    float3 f = p - fl;
    float3 u = f * f * f * (f * (f * 6.0f - 15.0f) + 10.0f);
    float g000 = pf_gr(pf_h3(i0, 0u), f.x, f.y, f.z);
    float g100 = pf_gr(pf_h3(i0 + (int3)(1, 0, 0), 0u), f.x - 1.0f, f.y, f.z);
    float g010 = pf_gr(pf_h3(i0 + (int3)(0, 1, 0), 0u), f.x, f.y - 1.0f, f.z);
    float g110 = pf_gr(pf_h3(i0 + (int3)(1, 1, 0), 0u), f.x - 1.0f, f.y - 1.0f, f.z);
    float g001 = pf_gr(pf_h3(i0 + (int3)(0, 0, 1), 0u), f.x, f.y, f.z - 1.0f);
    float g101 = pf_gr(pf_h3(i0 + (int3)(1, 0, 1), 0u), f.x - 1.0f, f.y, f.z - 1.0f);
    float g011 = pf_gr(pf_h3(i0 + (int3)(0, 1, 1), 0u), f.x, f.y - 1.0f, f.z - 1.0f);
    float g111 = pf_gr(pf_h3(i0 + (int3)(1, 1, 1), 0u), f.x - 1.0f, f.y - 1.0f, f.z - 1.0f);
    float x00 = mix(g000, g100, u.x), x10 = mix(g010, g110, u.x), x01 = mix(g001, g101, u.x), x11 = mix(g011, g111, u.x);
    return 0.982f * mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}
// Blender "Noise Texture" FBM, normalised to ~[0,1], lacunarity 2. p is already scaled.
float pf_fbm(float3 p, float detail, float rough)
{
    float fs = 1.0f, amp = 1.0f, maxa = 0.0f, sum = 0.0f;
    int n = (int)detail;
    for (int i = 0; i <= n; i++) { sum += pf_perlin(p * fs) * amp; maxa += amp; amp *= rough; fs *= 2.0f; }
    float rmd = detail - (float)n;
    if (rmd > 0.0f) {
        float s2 = sum + pf_perlin(p * fs) * amp;
        return 0.5f * mix(sum / maxa, s2 / (maxa + amp), rmd) + 0.5f;
    }
    return 0.5f * sum / maxa + 0.5f;
}
float3 pf_warp(float3 p, float amount)   // Blender noise "Distortion": p += snoise3(p) * amount
{
    return p + amount * (float3)(pf_perlin(p + (float3)(13.5f, 3.7f, 9.1f)), pf_perlin(p + (float3)(41.3f, 17.9f, 5.3f)), pf_perlin(p + (float3)(7.7f, 29.1f, 23.3f)));
}

// ---------------------------------------------------------------- colour
float3 pf_rgb2hsv(float3 c)
{
    float mx = fmax(c.x, fmax(c.y, c.z)), mn = fmin(c.x, fmin(c.y, c.z)), d = mx - mn;
    float h = 0.0f;
    if (d > 1e-8f) {
        if (mx == c.x) h = (c.y - c.z) / d; else if (mx == c.y) h = 2.0f + (c.z - c.x) / d; else h = 4.0f + (c.x - c.y) / d;
        h /= 6.0f; if (h < 0.0f) h += 1.0f;
    }
    return (float3)(h, mx > 0.0f ? d / mx : 0.0f, mx);
}
float3 pf_hsv2rgb(float3 c)
{
    float h = (c.x - floor(c.x)) * 6.0f;
    float3 k = clamp((float3)(fabs(h - 3.0f) - 1.0f, 2.0f - fabs(h - 2.0f), 2.0f - fabs(h - 4.0f)), 0.0f, 1.0f);
    return c.z * mix((float3)(1.0f), k, c.y);
}
// Blender Hue/Saturation/Value node (fac 1): hue 0.5 = no shift
float3 pf_hsv_adjust(float3 c, float hue, float sat, float val)
{
    float3 h = pf_rgb2hsv(c);
    h.x = h.x + hue - 0.5f; h.y = clamp(h.y * sat, 0.0f, 1.0f); h.z *= val;
    return pf_hsv2rgb(h);
}
float3 pf_euler_apply(float3 v, float3 r)   // Blender XYZ euler (radians): Rz * Ry * Rx * v
{
    float cx = cos(r.x), sx = sin(r.x), cy = cos(r.y), sy = sin(r.y), cz = cos(r.z), sz = sin(r.z);
    v = (float3)(v.x, cx * v.y - sx * v.z, sx * v.y + cx * v.z);
    v = (float3)(cy * v.x + sy * v.z, v.y, -sy * v.x + cy * v.z);
    return (float3)(cz * v.x - sz * v.y, sz * v.x + cz * v.y, v.z);
}

// ---------------------------------------------------------------- stars on the sphere
void pf_dir_to_face(float3 d, int* face, float* a, float* b)
{
    float3 ad = fabs(d);
    float m;
    if (ad.x >= ad.y && ad.x >= ad.z) { m = ad.x; if (d.x >= 0.0f) { *face = 0; *a = -d.z / m; *b = -d.y / m; } else { *face = 1; *a = d.z / m; *b = -d.y / m; } }
    else if (ad.y >= ad.z)            { m = ad.y; if (d.y >= 0.0f) { *face = 2; *a = d.x / m;  *b = d.z / m; }  else { *face = 3; *a = d.x / m; *b = -d.z / m; } }
    else                              { m = ad.z; if (d.z >= 0.0f) { *face = 4; *a = d.x / m;  *b = -d.y / m; } else { *face = 5; *a = -d.x / m; *b = -d.y / m; } }
}
typedef struct { float3 dir; float exists; float size; float cu; float du; } PfStar;
// one star per cube-face cell (face,i,j) with probability ~ the cell's solid angle, so density is uniform on the sphere
PfStar pf_cell_star(int face, int i, int j, int M, uint seed, float rho, float coverage, float nscale, float smin, float smax)
{
    PfStar s; s.exists = 0.0f; s.dir = (float3)(0.0f); s.size = 0.0f; s.cu = 0.0f; s.du = 0.0f;
    uint h = pf_h(pf_h(pf_h((uint)face * 1000003u + (uint)i * 7919u + (uint)j) + seed) ^ 0x1234567u);
    float ra = pf_u01(h), rb = pf_u01(pf_h(h + 1u)), rp = pf_u01(pf_h(h + 2u));
    float a = ((float)i + ra) / (float)M * 2.0f - 1.0f, b = ((float)j + rb) / (float)M * 2.0f - 1.0f;
    float q = 1.0f + a * a + b * b;
    float omega = (2.0f / (float)M) * (2.0f / (float)M) * rsqrt(q * q * q);
    s.dir = pf_cube_face_dir(face, a, b);
    float mask = pf_fbm(s.dir * nscale + (float3)((float)seed * 0.0137f), 3.0f, 0.5f);   // stars where the noise is low
    s.exists = (rp < rho * omega) ? (1.0f - smoothstep(coverage - 0.04f, coverage + 0.04f, mask)) : 0.0f;
    s.size = mix(smin, smax, pf_u01(pf_h(h + 3u)));
    s.cu = pf_u01(pf_h(h + 4u));
    s.du = pf_u01(pf_h(h + 5u));
    return s;
}

// ---------------------------------------------------------------- voronoi F1 (3D), Blender "Voronoi Texture" distance
float pf_voronoi_f1(float3 p)
{
    float3 fl = floor(p); float3 f = p - fl;
    int3 i0 = convert_int3(fl);
    float best = 8.0f;
    for (int z = -1; z <= 1; z++) for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        int3 c = i0 + (int3)(x, y, z);
        uint h = pf_h3(c, 77u);
        float3 o = (float3)(pf_u01(h), pf_u01(pf_h(h + 1u)), pf_u01(pf_h(h + 2u)));
        float3 dv = (float3)((float)x, (float)y, (float)z) + o - f;
        best = fmin(best, dot(dv, dv));
    }
    return sqrt(best);
}

// ---------------------------------------------------------------- the cloud (macro: needs the @ramps)
// Evaluates the density chain at object-space point PP with OCT octaves:
//   t = FBM(map(p) * FBM_coarse(map(p)*coarse_scale), distortion = FBM_fine(map(p)*dist_scale) * dist_mult)
//   main = main_ramp(t) * main_mult;  gas_val = gas_ramp(t);  gas = gas_val * gas_mult
#define PF_CLOUD(PP, OCT, MAINV, GASV) { \
    float3 pq_ = pf_euler_apply((PP) * @map_scale, mrot_) + @map_loc + seedoff_; \
    float n9_ = pf_fbm(pq_ * @coarse_scale, fmin((float)(OCT), 6.0f), @coarse_rough); \
    float n8_ = pf_fbm(pq_ * @dist_scale, fmin((float)(OCT), 4.0f), @dist_rough); \
    float tv_ = pf_fbm(pf_warp(pq_ * n9_, n8_ * @dist_mult), (float)(OCT), @cloud_rough); \
    MAINV = @main_ramp(tv_); GASV = @gas_ramp(tv_); }

@KERNEL
{
    float4 dd = pf_space_dir(@ix, @iy, @xres, @yres, @layout, @face, @convention);
    if (dd.w < 0.5f) { @color.set((float3)(0.0f)); @alpha.set(0.0f); return; }
    float3 d = dd.xyz;
    float3 o = @view;
    float3 mrot_ = @map_rot * (PF_PI / 180.0f);
    float3 seedoff_ = (float3)(@seed * 17.31f, @seed * -9.77f, @seed * 5.13f);
    int steps = clamp(@steps, 8, 160);
    int octs = clamp(@octaves, 1, 16);

    // ---- ray / falloff sphere
    float fall_end = 0.0f;
    for (int k = 0; k <= 32; k++) { if (@falloff_ramp((float)k / 32.0f) > 0.001f) fall_end = (float)(k + 1) / 32.0f; }
    float R = fmin(fall_end, 1.0f) * @falloff_size;
    float b_ = dot(o, d), c_ = dot(o, o) - R * R, disc = b_ * b_ - c_;
    float t0 = 0.0f, t1 = 0.0f;
    if (disc > 0.0f) { float sq = sqrt(disc); t0 = fmax(0.0f, -b_ - sq); t1 = -b_ + sq; }
    float dt = (t1 - t0) / (float)steps;
    uint pix = pf_h((uint)@ix * 73856093u ^ (uint)@iy * 19349663u ^ (uint)@seed);
    float jit0 = pf_u01(pix);
    int nsamp = clamp(@samples, 1, 16);

    float3 Lmain_dir = pf_euler_apply((float3)(0.0f, 0.0f, 1.0f), @light_rot * (PF_PI / 180.0f));   // towards the sun lamp
    float3 Ecol = @light_color * @light_strength;
    float sun_i = @sun_strength / (4.0f * PF_PI * PF_PI) * PF_LIGHT_GAIN;                                          // W -> intensity (Blender point lamp)

    float Tarr[160];
    float Tsum = 0.0f;
    float3 Lsum = (float3)(0.0f);
    for (int sidx = 0; sidx < 16; sidx++) {
    if (sidx >= nsamp) break;
    float jit = ((float)sidx + jit0) / (float)nsamp;
    float T = 1.0f;
    float3 L = (float3)(0.0f);
    for (int i = 0; i < 160; i++) {
        if (i >= steps) break;
        float tt = t0 + ((float)i + jit) * dt;
        float3 p = o + d * tt;
        float rr = length(p);
        float fac = @falloff_ramp(rr / @falloff_size);
        if (fac > 0.001f && T > 0.002f) {
            float dmain, gval;
            PF_CLOUD(p, octs, dmain, gval);
            float dens = (dmain * @main_mult + gval * @gas_mult) * @volume_unit * fac;
            if (dens > 1e-5f) {
                float mixf = clamp(dmain * @main_mult, 0.0f, 1.0f);
                float3 gc = pf_hsv_adjust(@gas_color_ramp(gval), @gas_hue, @gas_sat, @gas_val);
                gc = pf_hsv_adjust(gc, @hue, @sat, @val);
                float3 albedo = gc * (1.0f - mixf);
                // lighting: sun lamp with a coarse shadow march + unshadowed point lamp at sun_pos
                float3 Lin = (float3)(0.0f);
                if (@light_strength > 0.0f) {
                    float bl = dot(p, Lmain_dir), cl = dot(p, p) - R * R;
                    float lend = -bl + sqrt(fmax(bl * bl - cl, 0.0f));
                    int ns = clamp(@shadow_steps, 0, 12);
                    float tau = 0.0f;
                    if (ns > 0) {
                        float dl = lend / (float)ns;
                        for (int s = 0; s < 12; s++) {
                            if (s >= ns) break;
                            float3 ps = p + Lmain_dir * (((float)s + jit) * dl);
                            float fs = @falloff_ramp(length(ps) / @falloff_size);
                            if (fs > 0.001f) {
                                float sm, sg;
                                PF_CLOUD(ps, 4, sm, sg);
                                tau += (sm * @main_mult + sg * @gas_mult) * @volume_unit * fs * dl;
                            }
                        }
                    }
                    Lin += Ecol * (PF_LIGHT_GAIN * exp(-tau));
                }
                if (@sun_strength > 0.0f) {
                    float3 dv = @sun_pos - p;
                    float rw = length(dv) * @volume_unit;
                    if ((@sun_cutoff <= 0.0f || rw < @sun_cutoff * @volume_unit) && rw > 1e-3f) Lin += @sun_color * (sun_i / (rw * rw));
                }
                float scat = 1.0f - exp(-dens * dt);
                L += T * scat * albedo * Lin * (1.0f / (4.0f * PF_PI));
                T *= 1.0f - scat;
            }
        }
        Tarr[i] = T;
    }
    Lsum += L; Tsum += T;
    }
    float3 L = Lsum / (float)nsamp;
    float T = Tsum / (float)nsamp;

    // ---- stars (emission seen through the dust: transmittance at the star's distance)
    float3 S = (float3)(0.0f);
    float rho = (float)@star_count / (4.0f * PF_PI);
    int M = clamp((int)ceil(sqrt(16.0f * rho)), 8, 1024);
    float cell_ang = 1.5708f / (float)M;
    float smax_rad = fmin(radians(@star_size_max), 0.9f * cell_ang);
    float smin_rad = fmin(radians(@star_size_min), smax_rad);
    int Npix = @layout == 1 ? @yres / 3 : (@layout == 2 ? @xres : @yres / 2);
    float pixang = 1.5708f / (float)Npix;   // angular size of a pixel; sprites are widened to it (energy kept)
    int face; float fa, fb;
    pf_dir_to_face(d, &face, &fa, &fb);
    int ci = clamp((int)floor((fa + 1.0f) * 0.5f * (float)M), 0, M - 1);
    int cj = clamp((int)floor((fb + 1.0f) * 0.5f * (float)M), 0, M - 1);
    int seen[9]; int nseen = 0;
    for (int dj = -1; dj <= 1; dj++) for (int di = -1; di <= 1; di++) {
        int f2 = face, i2 = ci + di, j2 = cj + dj;
        if (i2 < 0 || i2 >= M || j2 < 0 || j2 >= M) {
            float3 dn = pf_cube_face_dir(face, ((float)i2 + 0.5f) / (float)M * 2.0f - 1.0f, ((float)j2 + 0.5f) / (float)M * 2.0f - 1.0f);
            float a2, b2; pf_dir_to_face(dn, &f2, &a2, &b2);
            i2 = clamp((int)floor((a2 + 1.0f) * 0.5f * (float)M), 0, M - 1);
            j2 = clamp((int)floor((b2 + 1.0f) * 0.5f * (float)M), 0, M - 1);
        }
        int id = (f2 * M + i2) * M + j2;
        bool dup = false;
        for (int q = 0; q < nseen; q++) if (seen[q] == id) dup = true;
        if (dup) continue;
        seen[nseen++] = id;
        PfStar st = pf_cell_star(f2, i2, j2, M, (uint)(@star_seed * 1000.0f), rho, @star_coverage, @star_noise_scale, smin_rad, smax_rad);
        if (st.exists > 0.0f) {
            float se = fmax(st.size, 0.7f * pixang);
            float x = length(d - st.dir) / se;
            if (x < 2.2f) {
                float dist = t1 * cbrt(st.du);
                int idx = clamp((int)((dist - t0) / fmax(dt, 1e-6f)), 0, steps - 1);
                float Ts = (disc > 0.0f && dist > t0) ? Tarr[idx] : 1.0f;
                float3 sc = pf_hsv_adjust(@star_ramp(st.cu), @star_hue, @star_sat, @star_val);
                S += sc * @star_strength * exp(-2.5f * x * x) * (st.size * st.size) / (se * se) * Ts * st.exists;
            }
        }
    }
    // large stars: core + 6-point glare
    for (int k = 0; k < 16; k++) {
        if (k >= @large_count) break;
        uint hk = pf_h((uint)k * 2654435u + (uint)@large_seed * 40503u);
        float uz = pf_u01(hk) * 2.0f - 1.0f, ph = pf_u01(pf_h(hk + 1u)) * 2.0f * PF_PI, rz = sqrt(1.0f - uz * uz);
        float3 sd = (float3)(rz * cos(ph), uz, rz * sin(ph));
        float size = radians(mix(@large_size_min, @large_size_max, pf_u01(pf_h(hk + 2u))));
        float cu = pf_u01(pf_h(hk + 3u)), du = pf_u01(pf_h(hk + 4u));
        float3 dv = d - sd * dot(d, sd);
        float se = fmax(size, 0.7f * pixang);
        float x = length(d - sd) / se;
        if (dot(d, sd) > 0.0f && x < 40.0f) {
            float3 e1 = normalize(cross(sd, fabs(sd.y) < 0.9f ? (float3)(0.0f, 1.0f, 0.0f) : (float3)(1.0f, 0.0f, 0.0f)));
            float3 e2 = cross(sd, e1);
            float ang = atan2(dot(dv, e2), dot(dv, e1));
            float spike = pow(fabs(cos(3.0f * ang)), 60.0f);
            float prof = exp(-2.5f * x * x) + @large_glare * (0.25f * spike / (1.0f + x * x * 0.25f) + 0.15f / (1.0f + x * x));
            float dist = t1 * cbrt(du);
            int idx = clamp((int)((dist - t0) / fmax(dt, 1e-6f)), 0, steps - 1);
            float Ts = (disc > 0.0f && dist > t0) ? Tarr[idx] : 1.0f;
            float3 sc = pf_hsv_adjust(@star_ramp(cu), @star_hue, @star_sat, @star_val);
            S += sc * @large_strength * prof * Ts;
        }
    }
    // background stars: two voronoi star fields, masked by noise (world shader of the .blend)
    float3 bg = (float3)(0.0f);
    if (@bg_stars > 0.0f) {
        float3 pw = pf_euler_apply(d, (float3)(0.0f, 0.05585f, 0.10088f)) * 1.39f + (float3)(66.6f, 0.0f, 0.0f);
        float m1 = smoothstep(0.2115f, 0.5317f, pf_fbm(pw * 5.0f, 2.0f, 0.5f));
        float v1 = clamp(1.0f - pf_voronoi_f1(pw * 44.0f) / 0.2364f, 0.0f, 1.0f);
        float m2 = smoothstep(0.5726f, 1.0f, pf_fbm(pw * 1.47f, 2.0f, 0.5f));
        float v2 = clamp(1.0f - pf_voronoi_f1(pw * 200.0f) / 0.2879f, 0.0f, 1.0f);
        bg = (float3)(1.0f, 0.898f, 0.9545f) * (m1 * v1 * 4.0f) + (float3)(1.0f, 0.9711f, 0.9711f) * (m2 * v2 * 2.0f);
        bg *= @bg_stars;
    }
    float3 outc = (L + S + bg * T) * @exposure;
    @color.set(outc);
    @alpha.set(1.0f - T);
}
